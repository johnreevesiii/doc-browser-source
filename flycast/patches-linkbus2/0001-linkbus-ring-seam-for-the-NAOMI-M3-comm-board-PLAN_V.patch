+TEST(pacer_lockstep_hold_force_catchup)
+{
+	FramePacer::Config c;
+	c.maxHoldFrames = 3;
+	c.maxCatchUp = 2;
+	c.maxBacklog = 4;
+	FramePacer p(c);
+	CHECK_EQ(p.framesToRun(), 1u);		// no tick yet: free run
+	p.onFrameRun();
+	p.reset();
+	// Lockstep: one tick per host frame gives one local frame.
+	u32 tick = 50;
+	for (int i = 0; i < 10; i++)
+	{
+		p.observeHubTick(tick++);
+		u32 k = p.framesToRun();
+		CHECK_EQ(k, 1u);
+		for (u32 j = 0; j < k; j++)
+			p.onFrameRun();
+	}
+	CHECK_EQ(p.stats().held, 0u);
+	// Hub stalls: hold maxHoldFrames host frames, then force one.
+	for (int i = 0; i < 3; i++)
+	{
+		p.observeHubTick(tick - 1);		// same tick again
+		CHECK_EQ(p.framesToRun(), 0u);
+	}
+	p.observeHubTick(tick - 1);
+	CHECK_EQ(p.framesToRun(), 1u);
+	p.onFrameRun();
+	CHECK_EQ(p.stats().held, 3u);
+	CHECK_EQ(p.stats().forced, 1u);
+	CHECK_EQ(p.credit(), -1);
+	// Hub bursts 4 ticks: the forced frame is repaid, then catch up 2 + 1.
+	tick += 4;
+	p.observeHubTick(tick - 1);
+	CHECK_EQ(p.credit(), 3);
+	u32 k = p.framesToRun();
+	CHECK_EQ(k, 2u);
+	for (u32 j = 0; j < k; j++) p.onFrameRun();
+	k = p.framesToRun();
+	CHECK_EQ(k, 1u);
+	p.onFrameRun();
+	CHECK_EQ(p.credit(), 0);
+	// Huge burst is clamped to the backlog.
+	tick += 20;
+	p.observeHubTick(tick);
+	CHECK_EQ(p.credit(), 4);
+	CHECK(p.stats().droppedCredit > 0u);
+	// Older tick (reordered) adds nothing.
+	p.observeHubTick(tick - 5);
+	CHECK_EQ(p.credit(), 4);
+}
