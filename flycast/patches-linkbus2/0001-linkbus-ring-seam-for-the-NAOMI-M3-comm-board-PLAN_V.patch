+extern "C" {
+
+// Install the mailbox ring backend. Returns 0 on success.
+EMSCRIPTEN_KEEPALIVE int linkbus_install_mailbox(int slotId, int slotCount, int edition,
+		unsigned sessionTag, unsigned waitMs)
+{
+	if (slotCount < 2 || slotCount > kMaxRingNodes || slotId < 0 || slotId >= slotCount)
+		return 1;
+	if (edition != (int)Edition::A && edition != (int)Edition::B)
+		return 2;
+	MailboxConfig cfg;
+	cfg.role.slotId = slotId;
+	cfg.role.slotCount = slotCount;
+	cfg.role.edition = (Edition)edition;
+	cfg.sessionTag = sessionTag;
+	cfg.waitMs = waitMs;
+	setRingBackend(makeMailboxRingBackend(cfg, std::make_unique<JsMailboxIo>()));
+	pacer.reset();
+	return 0;
+}
+
+EMSCRIPTEN_KEEPALIVE void linkbus_uninstall_ring() {
+	setRingBackend(nullptr);
+}
+
+EMSCRIPTEN_KEEPALIVE void linkbus_install_sab_multiboard() {
+	setMultiboardFactory([](int boardId) { return makeSabMultiboardBackend(boardId); });
+}
+
+// Pacing, once per host frame (see the file header).
+EMSCRIPTEN_KEEPALIVE int linkbus_pacer_frames()
+{
+	u32 tick;
+	if (ringBackend() != nullptr && ringBackend()->peekHubTick(&tick))
+		pacer.observeHubTick(tick);
+	return (int)pacer.framesToRun();
+}
+
+EMSCRIPTEN_KEEPALIVE void linkbus_pacer_frame_run() {
+	pacer.onFrameRun();
+}
+
+// Copies ring stats (7 u32) and pacer stats (4 u32) to out. Returns 0 if no ring.
+EMSCRIPTEN_KEEPALIVE int linkbus_stats(u32 *out)
+{
+	RingBackend *ring = ringBackend();
+	if (ring == nullptr)
+		return 0;
+	RingBackend::Stats s = ring->stats();
+	FramePacer::Stats p = pacer.stats();
+	const u32 v[] = { s.published, s.taken, s.stale, s.dropped, s.badEdition, s.badSize, s.badHeader,
+			p.held, p.forced, p.caughtUp, p.droppedCredit };
+	for (u32 i = 0; i < sizeof(v) / sizeof(v[0]); i++)
+		out[i] = v[i];
+	return 1;
+}
+
+} // extern "C"
+
+#endif // __EMSCRIPTEN__
