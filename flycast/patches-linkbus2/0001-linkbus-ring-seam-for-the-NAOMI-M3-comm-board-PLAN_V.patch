+// ---------------------------------------------------------------------------
+// Wire checks
+// ---------------------------------------------------------------------------
+
+FrameCheck checkSlotFrame(const u8 *bytes, u32 size, const WireExpect& expect,
+		SlotFrameHeader *out)
+{
+	SlotFrameHeader h;
+	if (bytes == nullptr || size < sizeof(h))
+		return FrameCheck::BadSize;
+	std::memcpy(&h, bytes, sizeof(h));
+	if (h.magic != kSlotMagic || h.version != kWireVersion || h.sessionTag != expect.sessionTag)
+		return FrameCheck::BadHeader;
+	// Edition is checked before geometry: a foreign edition is refused as such.
+	if (h.edition != (u8)expect.edition)
+		return FrameCheck::BadEdition;
+	if (expect.slotCount != 0 && h.slotCount != expect.slotCount)
+		return FrameCheck::BadSize;
+	if (h.slotCount < 2 || h.slotCount > kMaxRingNodes || h.nodeId >= h.slotCount)
+		return FrameCheck::BadHeader;
+	if (h.slotSize == 0 || (expect.slotSize != 0 && h.slotSize != expect.slotSize))
+		return FrameCheck::BadSize;
+	if (size != sizeof(h) + h.slotSize)
+		return FrameCheck::BadSize;
+	if (out != nullptr)
+		*out = h;
+	return FrameCheck::Ok;
+}
+
+FrameCheck checkAssembledFrame(const u8 *bytes, u32 size, const WireExpect& expect,
+		AssembledFrameHeader *out)
+{
+	AssembledFrameHeader h;
+	if (bytes == nullptr || size < sizeof(h))
+		return FrameCheck::BadSize;
+	std::memcpy(&h, bytes, sizeof(h));
+	if (h.magic != kAssembledMagic || h.version != kWireVersion || h.sessionTag != expect.sessionTag)
+		return FrameCheck::BadHeader;
+	if (h.edition != (u8)expect.edition)
+		return FrameCheck::BadEdition;
+	if (expect.targetNode >= 0 && h.targetNode != expect.targetNode)
+		return FrameCheck::BadHeader;
+	if (expect.slotCount != 0 && h.slotCount != expect.slotCount)
+		return FrameCheck::BadSize;
+	if (h.slotSize == 0 || (expect.slotSize != 0 && h.slotSize != expect.slotSize))
+		return FrameCheck::BadSize;
+	const u32 payload = (u32)h.slotSize * h.slotCount;
+	if (payload > kMaxPayload || size != sizeof(h) + payload)
+		return FrameCheck::BadSize;
+	if (out != nullptr)
+		*out = h;
+	return FrameCheck::Ok;
+}
+
+static void countCheck(FrameCheck c, RingBackend::Stats& st)
+{
+	switch (c)
+	{
+	case FrameCheck::BadEdition: st.badEdition++; break;
+	case FrameCheck::BadSize: st.badSize++; break;
+	case FrameCheck::BadHeader: st.badHeader++; break;
+	default: break;
+	}
+}
+
+static std::vector<u8> encodeSlotFrame(const u8 *txBase, u32 slotSize, int nodeId, int slotCount,
+		Edition edition, u16 packetNumber, u32 localFrame, u32 sessionTag)
+{
+	SlotFrameHeader h;
+	h.magic = kSlotMagic;
+	h.version = kWireVersion;
+	h.edition = (u8)edition;
+	h.nodeId = (u8)nodeId;
+	h.slotCount = (u8)slotCount;
+	h.slotSize = (u16)slotSize;
+	h.packetNumber = packetNumber;
+	h.localFrame = localFrame;
+	h.sessionTag = sessionTag;
+	std::vector<u8> frame(sizeof(h) + slotSize);
+	std::memcpy(frame.data(), &h, sizeof(h));
+	std::memcpy(frame.data() + sizeof(h), txBase, slotSize);
+	return frame;
+}
