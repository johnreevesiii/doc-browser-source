+// ---------------------------------------------------------------------------
+// Edition and header refusal
+// ---------------------------------------------------------------------------
+
+static std::vector<u8> makeSlotFrame(int node, int n, u32 S, Edition ed, u32 session, u16 pn, u32 g = 0)
+{
+	SlotFrameHeader h{};
+	h.magic = kSlotMagic;
+	h.version = kWireVersion;
+	h.edition = (u8)ed;
+	h.nodeId = (u8)node;
+	h.slotCount = (u8)n;
+	h.slotSize = (u16)S;
+	h.packetNumber = pn;
+	h.sessionTag = session;
+	std::vector<u8> f(sizeof(h) + S);
+	std::memcpy(f.data(), &h, sizeof(h));
+	auto s = slotOf(node, S, g);
+	std::memcpy(f.data() + sizeof(h), s.data(), S);
+	return f;
+}
+
+static std::vector<u8> makeAssembled(int target, int n, u32 S, Edition ed, u32 session, u32 tick, u16 prev, u32 g = 0)
+{
+	AssembledFrameHeader h{};
+	h.magic = kAssembledMagic;
+	h.version = kWireVersion;
+	h.edition = (u8)ed;
+	h.targetNode = (u8)target;
+	h.slotCount = (u8)n;
+	h.slotSize = (u16)S;
+	h.prevPacketNumber = prev;
+	h.hubTick = tick;
+	h.releaseFrame = tick;
+	h.sessionTag = session;
+	std::vector<u8> f(sizeof(h) + S * n);
+	std::memcpy(f.data(), &h, sizeof(h));
+	for (int k = 1; k <= n; k++)
+	{
+		auto s = slotOf(rxSourceNode(target, n, k), S, g);
+		std::memcpy(f.data() + sizeof(h) + S * (k - 1), s.data(), S);
+	}
+	return f;
+}
+
+TEST(edition_tag_refusal_wire_checks)
+{
+	WireExpect e;
+	e.edition = Edition::A;
+	e.sessionTag = 77;
+	e.slotCount = 5;
