+TEST(edition_tag_refusal_mailbox)
+{
+	const int n = 5;
+	const u32 S = 16;
+	std::vector<u8> region(MailboxLayout::totalBytes, 0);
+	MailboxConfig cfg;
+	cfg.role = { 2, n, Edition::A };
+	cfg.sessionTag = 5;
+	auto ring = makeMailboxRingBackend(cfg, makeBufferMailboxIo(region.data()));
+	auto bad = makeAssembled(2, n, S, Edition::B, 5, 1, 0);
+	mailboxDeliver(region.data(), bad.data(), (u32)bad.size());
+	std::vector<u8> rx(S * n, 0x33);
+	TakeResult r = ring->take(rx.data(), S, n, 0);
