+// ---------------------------------------------------------------------------
+// Mailbox
+// ---------------------------------------------------------------------------
+//
+// The buffer io is the byte-exact reference for the JS side. It is not
+// thread-safe: in the browser the JS glue uses Atomics on the SAB for the
+// i32 header words, and the transport writes a frame into a buffer that is
+// not latestIndex before publishing it (triple buffering).
+
+static u32 rd32(const u8 *p) { u32 v; std::memcpy(&v, p, 4); return v; }
+static void wr32(u8 *p, u32 v) { std::memcpy(p, &v, 4); }
+
+namespace {
+
+class BufferMailboxIo : public MailboxIo
+{
+public:
+	explicit BufferMailboxIo(u8 *region) : region(region) {}
+
+	u32 pullLatest(u8 *dst, u32 capacity, u32 *seqOut) override
+	{
+		*seqOut = rd32(region + MailboxLayout::seq);
+		if (*seqOut == 0)
+			return 0;
+		const u32 idx = rd32(region + MailboxLayout::latestIndex) % 3;
+		const u32 len = std::min(rd32(region + MailboxLayout::rxLength + 4 * idx), MailboxLayout::bufferBytes);
+		std::memcpy(dst, region + MailboxLayout::rxBuffer((int)idx), std::min(len, capacity));
+		return len;
+	}
+
+	void waitSeq(u32 seenSeq, u32 ms) override {
+		// Single-threaded reference: nothing can change while we wait.
+		(void)seenSeq; (void)ms;
+	}
+
+	void push(const u8 *frame, u32 length) override
+	{
+		length = std::min(length, (u32)(sizeof(SlotFrameHeader) + kMaxPayload));
+		std::memcpy(region + MailboxLayout::txBuffer, frame, length);
+		wr32(region + MailboxLayout::txLength, length);
+		wr32(region + MailboxLayout::txSeq, rd32(region + MailboxLayout::txSeq) + 1);
+	}
+
+	bool linkError() override {
+		return rd32(region + MailboxLayout::errorFlag) != 0;
+	}
+
+private:
+	u8 *region;
+};
+
+class MailboxRing : public RingBackend
+{
+public:
+	MailboxRing(const MailboxConfig& config, std::unique_ptr<MailboxIo> io)
+		: cfg(config), io(std::move(io)), buf(MailboxLayout::bufferBytes) {}
+
+	RingRole role() const override { return cfg.role; }
+	u32 defaultWaitMs() const override { return cfg.waitMs; }
+
+	bool publish(const u8 *txBase, u32 slotSize, u32 slotCount, u16 packetNumber) override
+	{
+		if (closed || slotSize == 0 || slotSize > kMaxPayload)
+			return !closed;
+		std::vector<u8> frame = encodeSlotFrame(txBase, slotSize, cfg.role.slotId, (int)slotCount,
+				cfg.role.edition, packetNumber, localFrame++, cfg.sessionTag);
+		io->push(frame.data(), (u32)frame.size());
+		st.published++;
+		return true;
+	}
+
+	TakeResult take(u8 *rxBase, u32 slotSize, u32 slotCount, u32 waitMs) override
+	{
+		TakeResult res;
+		if (closed || io->linkError()) {
+			res.error = true;
+			return res;
+		}
+		u32 seq;
+		u32 len = io->pullLatest(buf.data(), (u32)buf.size(), &seq);
+		if (seq == lastSeq && waitMs > 0)
+		{
+			io->waitSeq(lastSeq, waitMs);
+			if (io->linkError()) {
+				res.error = true;
+				return res;
+			}
+			len = io->pullLatest(buf.data(), (u32)buf.size(), &seq);
+		}
+		if (seq == lastSeq) {
+			st.stale++;
+			return res;
+		}
+		// Deliveries between two takes that were never read (latest wins).
+		const u32 skipped = seq - lastSeq - 1;
+		st.dropped += skipped;
+		lastSeq = seq;
+
+		WireExpect expect;
+		expect.edition = cfg.role.edition;
+		expect.sessionTag = cfg.sessionTag;
+		expect.slotCount = (int)slotCount;
+		expect.slotSize = slotSize;
+		expect.targetNode = cfg.role.slotId;
+		AssembledFrameHeader h;
+		FrameCheck c = checkAssembledFrame(buf.data(), len, expect, &h);
+		if (c != FrameCheck::Ok || (haveTick && (int)(h.hubTick - lastTick) <= 0))
+		{
+			countCheck(c, st);
+			st.stale++;
+			return res;
+		}
+		haveTick = true;
+		lastTick = h.hubTick;
+		std::memcpy(rxBase, buf.data() + sizeof(h), rxRegionSize(slotSize, (int)slotCount));
+		st.taken++;
+		res.fresh = true;
+		res.packetNumber = h.prevPacketNumber;
+		res.hubTick = h.hubTick;
+		return res;
+	}
+
+	bool peekHubTick(u32 *tick) override
+	{
+		u32 seq;
+		AssembledFrameHeader h;
+		u32 len = io->pullLatest((u8 *)&h, sizeof(h), &seq);
+		if (len >= sizeof(h) && h.magic == kAssembledMagic) {
+			*tick = h.hubTick;
+			return true;
+		}
+		return false;
+	}
+
+	void shutdown() override { closed = true; }
+	Stats stats() const override { return st; }
+
+private:
+	MailboxConfig cfg;
+	std::unique_ptr<MailboxIo> io;
+	std::vector<u8> buf;
+	Stats st;
+	u32 lastSeq = 0;
+	u32 localFrame = 0;
+	bool haveTick = false;
+	u32 lastTick = 0;
+	bool closed = false;
+};
+
+} // namespace
+
+std::unique_ptr<MailboxIo> makeBufferMailboxIo(u8 *region) {
+	return std::make_unique<BufferMailboxIo>(region);
+}
+
+void mailboxDeliver(u8 *region, const u8 *frame, u32 length)
+{
+	length = std::min(length, MailboxLayout::bufferBytes);
+	const u32 seq = rd32(region + MailboxLayout::seq);
+	const u32 idx = seq == 0 ? 0 : (rd32(region + MailboxLayout::latestIndex) + 1) % 3;
+	std::memcpy(region + MailboxLayout::rxBuffer((int)idx), frame, length);
+	wr32(region + MailboxLayout::rxLength + 4 * idx, length);
+	wr32(region + MailboxLayout::latestIndex, idx);
+	wr32(region + MailboxLayout::seq, seq + 1);
+}
+
+u32 mailboxReadTx(const u8 *region, u8 *dst, u32 capacity, u32 *txSeqOut)
+{
+	*txSeqOut = rd32(region + MailboxLayout::txSeq);
+	const u32 len = rd32(region + MailboxLayout::txLength);
+	std::memcpy(dst, region + MailboxLayout::txBuffer, std::min(len, capacity));
+	return len;
+}
+
+void mailboxSetError(u8 *region, bool error) {
+	wr32(region + MailboxLayout::errorFlag, error ? 1 : 0);
+}
+
+std::unique_ptr<RingBackend> makeMailboxRingBackend(const MailboxConfig& config,
+		std::unique_ptr<MailboxIo> io)
+{
+	return std::make_unique<MailboxRing>(config, std::move(io));
+}
