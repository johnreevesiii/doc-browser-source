+// Synthetic slot content: byte i of node `node`'s slot at generation g.
+static u8 pat(int node, u32 i, u32 g = 0) { return (u8)(0x10 * (node + 1) + (i * 7) + g * 31); }
+
+static std::vector<u8> slotOf(int node, u32 S, u32 g = 0)
+{
+	std::vector<u8> v(S);
+	for (u32 i = 0; i < S; i++)
+		v[i] = pat(node, i, g);
+	return v;
+}
+
+static bool slotIs(const u8 *p, int node, u32 S, u32 g = 0)
+{
+	for (u32 i = 0; i < S; i++)
+		if (p[i] != pat(node, i, g))
+			return false;
+	return true;
+}
+
+// ---------------------------------------------------------------------------
+// rxSourceNode
+// ---------------------------------------------------------------------------
+
+TEST(rxSourceNode_known_values)
+{
+	// n = 5, master
+	CHECK_EQ(rxSourceNode(0, 5, 1), 4);
+	CHECK_EQ(rxSourceNode(0, 5, 2), 3);
+	CHECK_EQ(rxSourceNode(0, 5, 4), 1);
+	CHECK_EQ(rxSourceNode(0, 5, 5), 0);		// echo
+	// n = 5, node 2
+	CHECK_EQ(rxSourceNode(2, 5, 1), 1);
+	CHECK_EQ(rxSourceNode(2, 5, 2), 0);
+	CHECK_EQ(rxSourceNode(2, 5, 3), 4);
+	CHECK_EQ(rxSourceNode(2, 5, 4), 3);
+	CHECK_EQ(rxSourceNode(2, 5, 5), 2);
+	// n = 9 (DOC maximum: master + 8)
+	CHECK_EQ(rxSourceNode(8, 9, 1), 7);
+	CHECK_EQ(rxSourceNode(1, 9, 2), 8);
+	CHECK_EQ(rxSlotOffset(0x80, 3), 0x100u + 0x180u);
+	CHECK_EQ(rxRegionSize(0x80, 9), 0x480u);
+}
+
+TEST(rxSourceNode_permutation_and_echo)
+{
+	for (int n = 2; n <= kMaxRingNodes; n++)
+		for (int own = 0; own < n; own++)
+		{
+			std::vector<int> seen(n, 0);
+			for (int k = 1; k <= n; k++)
+			{
+				int s = rxSourceNode(own, n, k);
+				CHECK(s >= 0 && s < n);
+				if (s >= 0 && s < n)
+					seen[s]++;
+			}
+			for (int i = 0; i < n; i++)
+				CHECK_EQ(seen[i], 1);
+			CHECK_EQ(rxSourceNode(own, n, n), own);
+			CHECK_EQ(rxSourceNode(own, n, 1), (own + n - 1) % n);
+		}
+}
+
+// Simulates the native UDP ring at 8412d3d8a: every vblank each node sends
+// comm_ram[0x100 .. 0x100 + n*S) to the next node, which copies it to
+// comm_ram[0x100 + S]. After enough laps slot k must hold node
+// rxSourceNode(own, n, k)'s own slot.
+TEST(rxSourceNode_matches_native_ring_forwarding)
+{
+	for (int n = 2; n <= 9; n++)
+	{
+		const u32 S = 6;
+		std::vector<std::vector<u8>> ram(n, std::vector<u8>(S * (n + 1), 0));
+		for (int i = 0; i < n; i++)
+		{
+			auto own = slotOf(i, S);
+			std::copy(own.begin(), own.end(), ram[i].begin());
+		}
+		for (int step = 0; step < 2 * n + 2; step++)
+		{
+			// Node order of one vblank does not matter for the steady state;
+			// send everyone's buffer from a snapshot (simultaneous hop).
+			auto snap = ram;
+			for (int i = 0; i < n; i++)
+			{
+				int next = (i + 1) % n;
+				std::copy(snap[i].begin(), snap[i].begin() + S * n, ram[next].begin() + S);
+			}
+		}
+		for (int own = 0; own < n; own++)
+			for (int k = 1; k <= n; k++)
+				CHECK(slotIs(&ram[own][S * k], rxSourceNode(own, n, k), S));
+	}
+}
+
+// ---------------------------------------------------------------------------
+// assembleRx
+// ---------------------------------------------------------------------------
+
+TEST(assembleRx_ordering)
+{
+	const int n = 6;
+	const u32 S = 8;
+	std::vector<std::vector<u8>> slots;
+	for (int i = 0; i < n; i++)
+		slots.push_back(slotOf(i, S));
+	std::vector<const u8 *> latest;
+	for (auto& s : slots)
+		latest.push_back(s.data());
+	for (int own = 0; own < n; own++)
+	{
+		std::vector<u8> rx(S * n, 0);
+		assembleRx(latest.data(), n, own, S, rx.data());
+		for (int k = 1; k <= n; k++)
+			CHECK(slotIs(&rx[S * (k - 1)], rxSourceNode(own, n, k), S));
+		// Echo slot (k = n) is the own slot.
+		CHECK(slotIs(&rx[S * (n - 1)], own, S));
+	}
+}
+
+TEST(assembleRx_missing_node_leaves_slot_unchanged)
+{
+	const int n = 5;
+	const u32 S = 4;
+	std::vector<std::vector<u8>> slots;
+	for (int i = 0; i < n; i++)
+		slots.push_back(slotOf(i, S));
+	std::vector<const u8 *> latest;
+	for (auto& s : slots)
+		latest.push_back(s.data());
+	latest[3] = nullptr;
+	const int own = 1;
+	std::vector<u8> rx(S * n, 0xEE);
+	assembleRx(latest.data(), n, own, S, rx.data());
+	for (int k = 1; k <= n; k++)
+	{
+		int src = rxSourceNode(own, n, k);
+		if (src == 3)
+		{
+			for (u32 i = 0; i < S; i++)
+				CHECK_EQ(rx[S * (k - 1) + i], 0xEE);
+		}
+		else
+			CHECK(slotIs(&rx[S * (k - 1)], src, S));
+	}
+}
