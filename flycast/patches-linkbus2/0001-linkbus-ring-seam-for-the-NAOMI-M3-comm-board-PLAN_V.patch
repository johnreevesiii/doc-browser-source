+// ---------------------------------------------------------------------------
+// InMemoryCabinet (multiboard, one process)
+// ---------------------------------------------------------------------------
+
+struct InMemoryCabinet::Impl
+{
+	std::mutex mutex;
+	std::condition_variable cond;
+	u16 status = 0;
+	bool exit = false;
+	u32 generation = 0;
+	u32 arrived = 0;		// bit per board
+	u32 boardMask = 1;		// master only until startPartners()
+	std::vector<u16> data = std::vector<u16>(kMbDataWords);
+	std::function<void(int)> *starter = nullptr;
+};
+
+namespace {
+
+class InMemoryBoard : public MultiboardBackend
+{
+public:
+	InMemoryBoard(std::shared_ptr<InMemoryCabinet::Impl> cab, int id, std::function<void(int)> *starter)
+		: cab(std::move(cab)), id(id), starter(starter) {}
+
+	int boardId() const override { return id; }
+
+	u16 status() const override { std::lock_guard<std::mutex> _(cab->mutex); return cab->status; }
+	void setStatus(u16 v) override { std::lock_guard<std::mutex> _(cab->mutex); cab->status = v; }
+	void statusOr(u16 bits) override { std::lock_guard<std::mutex> _(cab->mutex); cab->status |= bits; }
+	void statusAnd(u16 bits) override { std::lock_guard<std::mutex> _(cab->mutex); cab->status &= bits; }
+
+	u16 read16(u32 i) const override { return cab->data[i & (kMbDataWords - 1)]; }
+	void write16(u32 i, u16 v) override { cab->data[i & (kMbDataWords - 1)] = v; }
+	u32 read32(u32 i) const override
+	{
+		i &= kMbDataWords - 1;
+		u32 v = cab->data[i];
+		if (i + 1 < kMbDataWords)
+			v |= (u32)cab->data[i + 1] << 16;
+		return v;
+	}
+	void write32(u32 i, u32 v) override
+	{
+		i &= kMbDataWords - 1;
+		cab->data[i] = (u16)v;
+		if (i + 1 < kMbDataWords)
+			cab->data[i + 1] = (u16)(v >> 16);
+	}
+	void copyOut(u32 i, void *dst, u32 bytes) const override
+	{
+		i &= kMbDataWords - 1;
+		bytes = std::min<u32>(bytes, (kMbDataWords - i) * 2);
+		std::memcpy(dst, &cab->data[i], bytes);
+	}
+	const u16 *directData() const override { return cab->data.data(); }
+
+	BarrierResult barrier(u32 timeoutMs) override
+	{
+		std::unique_lock<std::mutex> lock(cab->mutex);
+		if (id != 0 && cab->exit)
+			return BarrierResult::Exit;
+		const u32 g = cab->generation;
+		cab->arrived |= 1u << id;
+		if ((cab->arrived & cab->boardMask) == cab->boardMask)
+		{
+			cab->arrived = 0;
+			cab->generation++;
+			cab->cond.notify_all();
+			return BarrierResult::Ok;
+		}
+		bool done = cab->cond.wait_for(lock, std::chrono::milliseconds(timeoutMs),
+				[&] { return cab->generation != g || (id != 0 && cab->exit); });
+		if (id != 0 && cab->exit)
+			return BarrierResult::Exit;
+		return done ? BarrierResult::Ok : BarrierResult::Timeout;
+	}
+
+	void requestExit() override
+	{
+		std::lock_guard<std::mutex> _(cab->mutex);
+		cab->exit = true;
+		cab->cond.notify_all();
+	}
+
+	void startPartners(int slaves) override
+	{
+		slaves = std::clamp(slaves, 0, kMbMaxBoards - 1);
+		{
+			std::lock_guard<std::mutex> _(cab->mutex);
+			cab->boardMask = (1u << (slaves + 1)) - 1;
+			cab->arrived = 0;
+		}
+		if (starter != nullptr && *starter)
+			for (int i = 1; i <= slaves; i++)
+				(*starter)(i);
+	}
+
+private:
+	std::shared_ptr<InMemoryCabinet::Impl> cab;
+	int id;
+	std::function<void(int)> *starter;
+};
+
+} // namespace
+
+InMemoryCabinet::InMemoryCabinet() : impl(std::make_shared<Impl>()) {}
+InMemoryCabinet::~InMemoryCabinet() = default;
+
+std::unique_ptr<MultiboardBackend> InMemoryCabinet::attach(int boardId)
+{
+	if (boardId < 0 || boardId >= kMbMaxBoards)
+		return nullptr;
+	return std::make_unique<InMemoryBoard>(impl, boardId, &partnerStarter);
+}
+
