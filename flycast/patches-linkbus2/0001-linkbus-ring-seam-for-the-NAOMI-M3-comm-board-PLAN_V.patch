+// Raw pointer on purpose: no destructor at exit, because NaomiM3Comm can be
+// destroyed during static destruction and still call ringBackend().
+static RingBackend *installedRing;
+static MultiboardFactory installedMultiboardFactory;
+
+RingBackend *ringBackend() {
