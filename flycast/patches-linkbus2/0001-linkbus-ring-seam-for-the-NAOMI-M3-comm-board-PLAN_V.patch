+TEST(mailbox_stale_dropped_replay_error_and_publish)
+{
+	const int n = 5;
+	const u32 S = 16;
+	std::vector<u8> region(MailboxLayout::totalBytes, 0);
+	MailboxConfig cfg;
+	cfg.role = { 1, n, Edition::B };
+	cfg.sessionTag = 1234;
+	auto ring = makeMailboxRingBackend(cfg, makeBufferMailboxIo(region.data()));
+	std::vector<u8> rx(S * n, 0x11);
+	CHECK(!ring->take(rx.data(), S, n, 0).fresh);
+	CHECK(!ring->take(rx.data(), S, n, 50).fresh);		// wait with nothing: still stale
+	CHECK_EQ(ring->stats().stale, 2u);
+	u32 tick = 0;
+	CHECK(!ring->peekHubTick(&tick));
+
+	for (u32 g = 1; g <= 3; g++)
+	{
+		auto f = makeAssembled(1, n, S, Edition::B, 1234, 100 + g, (u16)(g * 3), g);
+		mailboxDeliver(region.data(), f.data(), (u32)f.size());
+	}
+	CHECK(ring->peekHubTick(&tick));
+	CHECK_EQ(tick, 103u);
+	TakeResult r = ring->take(rx.data(), S, n, 0);
+	CHECK(r.fresh);
+	CHECK_EQ(r.packetNumber, 9);
+	CHECK_EQ(r.hubTick, 103u);
+	CHECK_EQ(ring->stats().dropped, 2u);
+	for (int k = 1; k <= n; k++)
+		CHECK(slotIs(&rx[S * (k - 1)], rxSourceNode(1, n, k), S, 3));
+	CHECK(!ring->take(rx.data(), S, n, 0).fresh);
+	// Replay of an older hub tick is refused (stale), bytes untouched.
+	std::vector<u8> before = rx;
+	auto old = makeAssembled(1, n, S, Edition::B, 1234, 102, 6, 9);
+	mailboxDeliver(region.data(), old.data(), (u32)old.size());
+	CHECK(!ring->take(rx.data(), S, n, 0).fresh);
+	CHECK(rx == before);
+	// Publish writes one slot frame for the hub.
+	std::vector<u8> tx(S * n);
+	for (u32 i = 0; i < S * n; i++)
+		tx[i] = (u8)i;
+	CHECK(ring->publish(tx.data(), S, n, 0x4321));
+	std::vector<u8> out(sizeof(SlotFrameHeader) + kMaxPayload);
+	u32 txSeq = 0;
+	u32 len = mailboxReadTx(region.data(), out.data(), (u32)out.size(), &txSeq);
+	CHECK_EQ(txSeq, 1u);
+	CHECK_EQ(len, (u32)sizeof(SlotFrameHeader) + S);
+	WireExpect e;
+	e.edition = Edition::B;
+	e.sessionTag = 1234;
+	e.slotCount = n;
+	e.slotSize = S;
+	SlotFrameHeader h;
+	CHECK(checkSlotFrame(out.data(), len, e, &h) == FrameCheck::Ok);
+	CHECK_EQ(h.nodeId, 1);
+	CHECK_EQ(h.packetNumber, 0x4321);
+	CHECK_EQ(out[sizeof(SlotFrameHeader) + S - 1], (u8)(S - 1));
+	// Link loss.
+	mailboxSetError(region.data(), true);
+	CHECK(ring->take(rx.data(), S, n, 0).error);
+}
