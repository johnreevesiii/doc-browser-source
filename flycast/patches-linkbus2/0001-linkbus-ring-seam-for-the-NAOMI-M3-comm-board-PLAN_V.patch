+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <functional>
+#include <memory>
+
+namespace linkbus
+{
+
+using u8 = std::uint8_t;
+using u16 = std::uint16_t;
+using u32 = std::uint32_t;
+
+// ---------------------------------------------------------------------------
+// Common
+// ---------------------------------------------------------------------------
+
+// Edition tag carried by every star frame and by the join (PLAN_V2 I2). A frame
+// whose edition differs from the local one is dropped and counted.
+enum class Edition : u8
+{
+	Unknown = 0,
+	A = 1,	// stock Rev C
+	B = 2,	// Rev C plus FIXROM Q01, Q04, Q17
+};
+
+// ---------------------------------------------------------------------------
+// Part 1: ring (replaces NaomiNetwork as used by NaomiM3Comm)
+// ---------------------------------------------------------------------------
+//
+//   comm_ram[0x0000..0x001f]  CommBoardStat, transcnt at +6
+//   comm_ram[0x0100 + 0*S]    own slot (DMA OUT)
+//   comm_ram[0x0100 + k*S]    k = 1..n: slot of node (own + n - k) mod n;
+//                             k = n is the own slot back from a full lap.
+
+constexpr u32 kCommTxOffset = 0x100;
+constexpr u32 kMaxPayload = 0x4000;		// NaomiNetwork Packet payload size
+constexpr int kMaxRingNodes = 16;
+
+// RX source for slot k (1 <= k <= n) at node `own` of an n-node ring.
+constexpr int rxSourceNode(int own, int n, int k)
+{
+	return (own + n - (k % n)) % n;
+}
+
+constexpr u32 rxSlotOffset(u32 slotSize, int k)
+{
+	return kCommTxOffset + slotSize * (u32)k;
+}
+
+constexpr u32 rxRegionSize(u32 slotSize, int slotCount)
+{
+	return slotSize * (u32)slotCount;
+}
+
+struct RingRole
+{
+	int slotId = 0;			// 0 = master, 1..n-1 = satellites
+	int slotCount = 0;		// n; < 2 means no link
+	Edition edition = Edition::Unknown;
+};
+
+struct TakeResult
+{
+	bool fresh = false;		// a newer frame was copied in; false: rxBase untouched
+	u16 packetNumber = 0;	// for CommBoardStat.transcnt, only when fresh
+	bool error = false;		// fatal: caller zeroes comm_status1/2
+	u32 hubTick = 0;		// star backends: tick of the frame taken (pacing)
+};
+
+class RingBackend
+{
+public:
+	virtual ~RingBackend() = default;
+
+	virtual RingRole role() const = 0;
+
+	// How long NaomiM3Comm::vblank() lets take() wait for a fresh frame.
+	// UDP: 100 (native parity). Star backends: 0 by default.
+	virtual u32 defaultWaitMs() const { return 0; }
+
+	// txBase = &comm_ram[kCommTxOffset], valid for slotSize * slotCount bytes.
+	// Ring backends send all of it; star backends send the first slotSize.
+	// Never blocks. Returns false on a fatal error.
+	virtual bool publish(const u8 *txBase, u32 slotSize, u32 slotCount,
+			u16 packetNumber) = 0;
+
+	// rxBase = &comm_ram[kCommTxOffset + slotSize]; filled for
+	// rxRegionSize(slotSize, slotCount) bytes when fresh.
+	virtual TakeResult take(u8 *rxBase, u32 slotSize, u32 slotCount,
+			u32 waitMs) = 0;
+
+	virtual void shutdown() = 0;
+
+	// Star backends: newest hub tick available, without consuming it (for
+	// FramePacer). Returns false when unknown (UDP, nothing received yet).
+	virtual bool peekHubTick(u32 *tick) { (void)tick; return false; }
+
+	struct Stats
+	{
+		u32 published = 0;
+		u32 taken = 0;
+		u32 stale = 0;			// take() with no fresh frame
+		u32 dropped = 0;		// frames overwritten before being taken
+		u32 badEdition = 0;
+		u32 badSize = 0;
+		u32 badHeader = 0;		// magic, version, target, session
+	};
+	virtual Stats stats() const = 0;
+};
+
+// Installed backend. When nothing is installed, NaomiM3Comm uses the native
+// UDP ring (makeUdpRingBackend()), so native builds behave as at 8412d3d8a.
+RingBackend *ringBackend();
+void setRingBackend(std::unique_ptr<RingBackend> backend);
+bool ringBackendInstalled();
+
+// Native backend over the NaomiNetwork UDP ring (linkbus_udp.cpp).
+std::unique_ptr<RingBackend> makeUdpRingBackend();
+
+// ---- Star wire format ------------------------------------------------------
+// Little-endian. Slot payload bytes are copied verbatim, never interpreted.
+
+constexpr u32 kSlotMagic = 0x3152424C;		// "LBR1"
+constexpr u32 kAssembledMagic = 0x3141424C;	// "LBA1"
+constexpr u8 kWireVersion = 1;
+
+#pragma pack(push, 1)
+// Seat -> hub: one per vblank, followed by slotSize payload bytes.
+struct SlotFrameHeader
+{
+	u32 magic;
+	u8 version;
+	u8 edition;
+	u8 nodeId;
+	u8 slotCount;
+	u16 slotSize;
+	u16 packetNumber;
+	u32 localFrame;		// sender publish counter since link start
+	u32 sessionTag;
+};
+
+// Hub -> seat: followed by slotSize * slotCount bytes in rxSourceNode() order.
+struct AssembledFrameHeader
+{
+	u32 magic;
+	u8 version;
+	u8 edition;
+	u8 targetNode;
+	u8 slotCount;
+	u16 slotSize;
+	u16 prevPacketNumber;	// packetNumber of node (target + n - 1) mod n
+	u32 hubTick;			// strictly increasing; freshness test
+	u32 releaseFrame;		// equal-delay release point (PLAN_V2 3.2)
+	u32 sessionTag;
+};
+#pragma pack(pop)
+
+static_assert(sizeof(SlotFrameHeader) == 20, "SlotFrameHeader layout");
+static_assert(sizeof(AssembledFrameHeader) == 24, "AssembledFrameHeader layout");
+
+// Reference assembly. latest[i] is node i's newest delayed slot or nullptr
+// (that RX slot is then left unchanged in rxOut).
+inline void assembleRx(const u8 *const latest[], int n, int own, u32 slotSize,
+		u8 *rxOut)
+{
+	for (int k = 1; k <= n; k++)
+	{
+		const u8 *src = latest[rxSourceNode(own, n, k)];
+		if (src != nullptr)
+			std::memcpy(rxOut + slotSize * (u32)(k - 1), src, slotSize);
+	}
+}
+
+// Validation shared by the hub, the in-memory seats and the mailbox seats.
+enum class FrameCheck
+{
+	Ok,
+	BadHeader,		// magic, version, session, node or target out of range
+	BadEdition,
+	BadSize,		// slot size, slot count or byte count mismatch
+};
+
+struct WireExpect
+{
+	Edition edition = Edition::Unknown;
+	u32 sessionTag = 0;
+	int slotCount = 0;		// 0 = not checked (hub learns it from the first frame)
+	u32 slotSize = 0;		// 0 = not checked
+	int targetNode = -1;	// assembled frames only; -1 = not checked
+};
+
+FrameCheck checkSlotFrame(const u8 *bytes, u32 size, const WireExpect& expect,
+		SlotFrameHeader *out);
+FrameCheck checkAssembledFrame(const u8 *bytes, u32 size, const WireExpect& expect,
+		AssembledFrameHeader *out);
+
+// ---- Frame pacing (CLAIM_FAIRNESS R3) ----------------------------------------
+// Natively, the 100 ms receive spin in vblank couples every board's frame rate
+// to its ring predecessor. Star backends never block, so the host loop must
+// pace each seat: one local frame per hub tick (master pass), holding when the
+// hub is behind and catching up a bounded number of frames when it is ahead.
+// The pacer only advises; the host (worker loop) decides whether to run
+// retro_run(). Nothing here changes game state.
+class FramePacer
+{
+public:
+	struct Config
+	{
+		u32 maxHoldFrames = 6;	// consecutive holds before running anyway (like the native timeout)
+		u32 maxCatchUp = 2;		// local frames per host frame when behind
+		u32 maxBacklog = 8;		// credit above this is dropped (counted)
+	};
+	FramePacer() = default;
+	explicit FramePacer(const Config& config) : cfg(config) {}
+
+	// Called once per host frame, before framesToRun(), with the newest hub
+	// tick available to this seat (RingBackend::peekHubTick() or, in the
+	// browser, read by JS from the mailbox). Polling outside take() avoids a
+	// deadlock: a held seat runs no vblank, so it never calls take().
+	void observeHubTick(u32 tick);
+	// How many local frames to run now (0..maxCatchUp).
+	u32 framesToRun();
+	// Called after each local frame actually run.
+	void onFrameRun();
+
+	struct Stats
+	{
+		u32 held = 0;			// host frames with 0 local frames
+		u32 forced = 0;			// frames run after maxHoldFrames without credit
+		u32 caughtUp = 0;		// extra frames run beyond 1 in a host frame
+		u32 droppedCredit = 0;	// ticks discarded above maxBacklog
+	};
+	Stats stats() const { return st; }
+	int credit() const { return creditTicks; }
+	void reset();
+
+private:
+	Config cfg;
+	Stats st;
+	bool haveTick = false;
+	u32 lastTick = 0;
+	int creditTicks = 0;
+	u32 holdRun = 0;
+};
+
+// ---- In-memory star (native tests, single-page play) -----------------------
+// All seats in one process. The driver calls tick() once per hub frame;
+// delayFrames is the equal delay L. A seat's publish() goes through the same
+// wire encoding and checks as a remote seat.
+class InMemoryHub
+{
+public:
+	InMemoryHub(int slotCount, Edition edition, u32 delayFrames, u32 sessionTag = 0x4C424D31);
+	~InMemoryHub();
+	InMemoryHub(const InMemoryHub&) = delete;
+	InMemoryHub& operator=(const InMemoryHub&) = delete;
+
+	// Seat backends hold a reference to the hub; destroy them first.
+	std::unique_ptr<RingBackend> attach(int slotId, Edition seatEdition);
+	std::unique_ptr<RingBackend> attach(int slotId);
+	void tick();
+	void fail();
+
+	// Raw wire entry point (also used by tests to inject foreign frames).
+	FrameCheck submit(const u8 *bytes, u32 size);
+	u32 hubTick() const;
+
+	struct Stats
+	{
+		u32 accepted = 0;
+		u32 badEdition = 0;
+		u32 badSize = 0;
+		u32 badHeader = 0;
+	};
+	Stats stats() const;
+
+	struct Impl;
+private:
+	std::unique_ptr<Impl> impl;
+};
+
+// ---- Mailbox (browser) ------------------------------------------------------
+// Byte layout of the mailbox SharedArrayBuffer, shared with the JS host.
+// The transport writes assembled frames to one of three RX buffers, stores
+// latestIndex, then bumps seq. The core writes its slot frame to txBuffer and
+// bumps txSeq.
+
+struct MailboxLayout
+{
+	static constexpr u32 seq = 0;			// i32
+	static constexpr u32 latestIndex = 4;	// i32, 0..2
+	static constexpr u32 errorFlag = 8;		// i32, nonzero = link lost
+	static constexpr u32 txSeq = 12;		// i32
+	static constexpr u32 rxLength = 16;		// i32[3] at 16, 20, 24: bytes in rx buffer i
+	static constexpr u32 txLength = 28;		// i32
+	static constexpr u32 headerBytes = 64;
+	static constexpr u32 bufferBytes = sizeof(AssembledFrameHeader) + kMaxPayload;
+	static constexpr u32 rxBuffer(int i) { return headerBytes + bufferBytes * (u32)i; }
+	static constexpr u32 txBuffer = headerBytes + bufferBytes * 3;
+	static constexpr u32 totalBytes = txBuffer + sizeof(SlotFrameHeader) + kMaxPayload;
+};
+
+// The core's access to a mailbox. Native/test: a plain byte buffer
+// (makeBufferMailboxIo). Browser: JS imports over the SAB (linkbus_web.cpp).
+class MailboxIo
+{
+public:
+	virtual ~MailboxIo() = default;
+	// Copy min(capacity, length) bytes of the newest RX frame. Returns its full
+	// length (0 if none) and the delivery count seq (0 = nothing delivered yet).
+	virtual u32 pullLatest(u8 *dst, u32 capacity, u32 *seqOut) = 0;
+	// Wait up to ms for seq to differ from `seenSeq`. May return early.
+	virtual void waitSeq(u32 seenSeq, u32 ms) = 0;
+	virtual void push(const u8 *frame, u32 length) = 0;
+	virtual bool linkError() = 0;
+};
+
+// Buffer-backed io over a MailboxLayout region (tests, and the reference for
+// the JS side). The region must stay alive while the io is used.
+std::unique_ptr<MailboxIo> makeBufferMailboxIo(u8 *region);
+// Transport-side helpers for the same region (what JS does).
+void mailboxDeliver(u8 *region, const u8 *frame, u32 length);
+u32 mailboxReadTx(const u8 *region, u8 *dst, u32 capacity, u32 *txSeqOut);
+void mailboxSetError(u8 *region, bool error);
+
+struct MailboxConfig
+{
+	RingRole role;
+	u32 sessionTag = 0;
+	u32 waitMs = 0;		// default for NaomiM3Comm (0: never block the worker)
+};
+std::unique_ptr<RingBackend> makeMailboxRingBackend(const MailboxConfig& config,
+		std::unique_ptr<MailboxIo> io);
+
+// ---------------------------------------------------------------------------
+// Part 2: multiboard (replaces shm, IPC mutex/condvar and os_RunInstance)
+// ---------------------------------------------------------------------------
+
+constexpr u32 kMbDataWords = 0x100000 / sizeof(u16);	// MEM_SIZE
+constexpr int kMbMaxBoards = 4;
+constexpr int kMbBaseSyncCycles = 836208;
+constexpr u32 kMbBarrierTimeoutMs = 5000;
+
+struct MultiboardSabLayout
+{
+	static constexpr u32 status = 0;		// i32, low 16 bits = native status
+	static constexpr u32 exit = 4;			// i32
+	static constexpr u32 generation = 8;	// i32
+	static constexpr u32 arrived = 12;		// i32
+	static constexpr u32 boardMask = 16;	// i32, bit i = board i takes part in the barrier
+	static constexpr u32 headerBytes = 64;
+	static constexpr u32 data = headerBytes;
+	static constexpr u32 totalBytes = headerBytes + kMbDataWords * sizeof(u16);
+};
+
+enum class BarrierResult
+{
+	Ok,			// every board arrived
+	Timeout,	// phase 1 timed out; native logs and returns early (non-fatal)
+	Exit,		// slave: the master is gone; native throws "Slave exit"
+};
+
+class MultiboardBackend
+{
+public:
+	virtual ~MultiboardBackend() = default;
+
+	virtual int boardId() const = 0;
+
+	virtual u16 status() const = 0;
+	virtual void setStatus(u16 v) = 0;
+	virtual void statusOr(u16 bits) = 0;
+	virtual void statusAnd(u16 bits) = 0;
+
+	// Word-indexed like sharedMem->data[]. Multiboard keeps the native index
+	// arithmetic and masking. The native shm backend indexes unmasked, exactly
+	// as 8412d3d8a; the in-memory and SAB backends mask to kMbDataWords so an
+	// out-of-range index cannot leave the bank.
+	virtual u16 read16(u32 wordIndex) const = 0;
+	virtual void write16(u32 wordIndex, u16 v) = 0;
+	virtual u32 read32(u32 wordIndex) const = 0;
+	virtual void write32(u32 wordIndex, u32 v) = 0;
+	virtual void copyOut(u32 wordIndex, void *dst, u32 bytes) const = 0;
+	// Direct pointer to the bank if it lives in this address space, else nullptr.
+	virtual const u16 *directData() const { return nullptr; }
+
+	virtual BarrierResult barrier(u32 timeoutMs) = 0;
+	virtual void requestExit() = 0;
+
+	// Master, first sync point: start the partner board(s). Returns at once.
+	// Sets the number of boards taking part in the barrier to slaves + 1.
+	virtual void startPartners(int slaves) = 0;
+
+	// Desktop keyboard forwarding (slave to master). Default: none.
+	virtual void sendKeyboard(u16 code, bool pressed) { (void)code; (void)pressed; }
+	virtual bool pollKeyboard(u16 *code, bool *pressed) { (void)code; (void)pressed; return false; }
+};
+
+// Optional factory. When unset, Multiboard uses its native shared memory backend.
+using MultiboardFactory = std::function<std::unique_ptr<MultiboardBackend>(int boardId)>;
+void setMultiboardFactory(MultiboardFactory factory);
+const MultiboardFactory& multiboardFactory();
+
+// In-process cabinet (both boards in one process, threads or one thread for
+// tests). Barrier semantics: a generation barrier over the boards in
+// boardMask, the same as the SAB backend. partnerStarter is called by
+// startPartners() with the board ids to start (may be empty).
+class InMemoryCabinet
+{
+public:
+	InMemoryCabinet();
+	~InMemoryCabinet();
+	std::unique_ptr<MultiboardBackend> attach(int boardId);
+	std::function<void(int boardId)> partnerStarter;
+
+	struct Impl;
+private:
+	std::shared_ptr<Impl> impl;
+};
+
+// Browser: SAB plus Atomics through JS imports (linkbus_web.cpp, Emscripten).
+std::unique_ptr<MultiboardBackend> makeSabMultiboardBackend(int boardId);
+
+} // namespace linkbus
diff --git a/core/network/linkbus_udp.cpp b/core/network/linkbus_udp.cpp
