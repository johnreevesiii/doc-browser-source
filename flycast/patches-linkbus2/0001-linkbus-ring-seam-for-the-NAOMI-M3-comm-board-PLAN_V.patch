@@ -0,0 +1,109 @@
+/*
+	LinkBus native ring backend: the NaomiNetwork UDP ring, unchanged.
+
+	Copyright (C) 2026 John R Reeves III
+	SPDX-License-Identifier: GPL-2.0-or-later
+
+	This program is free software: you can redistribute it and/or modify
+	it under the terms of the GNU General Public License as published by
+	the Free Software Foundation, either version 2 of the License, or
+	(at your option) any later version.
+
+	This program is distributed in the hope that it will be useful,
+	but WITHOUT ANY WARRANTY; without even the implied warranty of
+	MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+	GNU General Public License for more details.
+
+	Behaviour is that of NaomiM3Comm::receiveNetwork(), sendNetwork() and the
+	vblank receive loop at 8412d3d8a, moved here without change:
+	- take() polls NaomiNetwork::receive() until a packet arrives or waitMs
+	  (100 natively) has passed, then logs "No data received".
+	- The receive buffer is zero-filled and copied whole, so a short packet
+	  zeroes the rest of the RX region, and NaomiNetwork's partial erase quirk
+	  (LINKBUS.md 3.1) is kept as it is.
+	- Any FlycastException (socket error, NAK, unknown packet) is a link error.
+*/
+#include "types.h"
+#include "linkbus.h"
+#include "naomi_network.h"
+
+#include <chrono>
+#include <memory>
+
+namespace linkbus
+{
+
+namespace {
+
+class UdpRing : public RingBackend
+{
+public:
+	RingRole role() const override
+	{
+		RingRole r;
+		r.slotId = naomiNetwork.getSlotId();
+		r.slotCount = naomiNetwork.getSlotCount();
+		r.edition = Edition::Unknown;	// the UDP ring carries no edition tag
+		return r;
+	}
+
+	u32 defaultWaitMs() const override { return 100; }
+
+	bool publish(const u8 *txBase, u32 slotSize, u32 slotCount, u16 packetNumber) override
+	{
+		try {
+			naomiNetwork.send(const_cast<u8 *>(txBase), slotSize * slotCount, packetNumber);
+		} catch (const FlycastException&) {
+			return false;
+		}
+		st.published++;
+		return true;
+	}
+
+	TakeResult take(u8 *rxBase, u32 slotSize, u32 slotCount, u32 waitMs) override
+	{
+		using the_clock = std::chrono::high_resolution_clock;
+		the_clock::time_point start = the_clock::now();
+		TakeResult res;
+		const u32 packetSize = slotSize * slotCount;
+		std::unique_ptr<u8[]> buf = std::make_unique<u8[]>(packetSize);
+		u16 packetNumber = 0;
+		bool received = false;
+		try {
+			do {
+				received = naomiNetwork.receive(buf.get(), packetSize, &packetNumber);
+			} while (!received && the_clock::now() - start < std::chrono::milliseconds(waitMs));
+		} catch (const FlycastException&) {
+			res.error = true;
+			return res;
+		}
+		if (!received)
+		{
+			INFO_LOG(NETWORK, "No data received");
+			st.stale++;
+			return res;
+		}
+		memcpy(rxBase, buf.get(), packetSize);
+		st.taken++;
+		res.fresh = true;
+		res.packetNumber = packetNumber;
+		return res;
+	}
+
+	void shutdown() override {
+		naomiNetwork.shutdown();
+	}
+
+	Stats stats() const override { return st; }
+
+private:
+	Stats st;
+};
+
+} // namespace
+
+std::unique_ptr<RingBackend> makeUdpRingBackend() {
+	return std::make_unique<UdpRing>();
+}
+
+} // namespace linkbus
diff --git a/core/network/linkbus_web.cpp b/core/network/linkbus_web.cpp
new file mode 100644
index 000000000..0bdb5aa8e
--- /dev/null
+++ b/core/network/linkbus_web.cpp
@@ -0,0 +1,364 @@
+/*
+	LinkBus browser bridge (Emscripten only): mailbox ring backend and SAB
+	multiboard backend over SharedArrayBuffers owned by the host page, plus the
+	C entry points the host page calls. No transport here: WebRTC, WebSocket or
+	an in-page hub live on the JS side and only read and write the mailbox.
+
+	Copyright (C) 2026 John R Reeves III
+	SPDX-License-Identifier: GPL-2.0-or-later
+
+	This program is free software: you can redistribute it and/or modify
+	it under the terms of the GNU General Public License as published by
+	the Free Software Foundation, either version 2 of the License, or
+	(at your option) any later version.
+
+	This program is distributed in the hope that it will be useful,
+	but WITHOUT ANY WARRANTY; without even the implied warranty of
+	MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+	GNU General Public License for more details.
+
+	JS contract (host page or worker, before retro_load_game()):
+
+	  Module.linkbus = {
+	    mailbox: SharedArrayBuffer(MailboxLayout::totalBytes),   // ring, one per seat
+	    cabinet: SharedArrayBuffer(MultiboardSabLayout::totalBytes), // master pair
+	    post: function (msg) { ... },   // optional; default self.postMessage
+	  };
+	  Module._linkbus_install_mailbox(slotId, slotCount, edition, sessionTag, waitMs);
+	  Module._linkbus_install_sab_multiboard();   // master pair only
+
+	  Messages posted by the core:
+	    { type: 'linkbus-tx', seq }                       after each slot frame
+	    { type: 'linkbus-start-partners', boardId, slaves } master, first sync
+
+	The transport writes an assembled frame into RX buffer (latestIndex + 1) % 3,
+	stores its length, stores latestIndex, then Atomics.add(seq, 1) and
+	Atomics.notify(seq). The byte-exact reference is the buffer io in
+	linkbus.cpp (makeBufferMailboxIo, mailboxDeliver, mailboxReadTx).
+
+	Host loop pacing (CLAIM_FAIRNESS R3), once per host frame:
+	    n = Module._linkbus_pacer_frames();
+	    for (i = 0; i < n; i++) { retro_run(); Module._linkbus_pacer_frame_run(); }
+*/
+#ifdef __EMSCRIPTEN__
+
+#include "linkbus.h"
+
+#include <emscripten.h>
+#include <memory>
+
+// ---------------------------------------------------------------------------
+// JS imports: ring mailbox
+// ---------------------------------------------------------------------------
+
+EM_JS(int, lb_mb_pull, (unsigned char *dst, int capacity, unsigned *seqOut,
+		int headerBytes, int bufferBytes), {
+	var lb = Module.linkbus;
+	if (!lb || !lb.mailbox) { HEAPU32[seqOut >> 2] = 0; return 0; }
+	var i32 = lb._mbI32 || (lb._mbI32 = new Int32Array(lb.mailbox, 0, headerBytes >> 2));
+	for (var attempt = 0; attempt < 3; attempt++) {
+		var seq = Atomics.load(i32, 0) >>> 0;
+		if (seq === 0) { HEAPU32[seqOut >> 2] = 0; return 0; }
+		var idx = (Atomics.load(i32, 1) >>> 0) % 3;
+		var len = Math.min(Atomics.load(i32, 4 + idx) >>> 0, bufferBytes);
+		HEAPU8.set(new Uint8Array(lb.mailbox, headerBytes + bufferBytes * idx, Math.min(len, capacity)), dst);
+		// Triple buffer: the copy is torn only if the writer lapped us twice.
+		if (((Atomics.load(i32, 0) >>> 0) - seq) < 2) {
+			HEAPU32[seqOut >> 2] = seq;
+			return len;
+		}
+	}
+	HEAPU32[seqOut >> 2] = 0;
+	return 0;
+});
+
+EM_JS(void, lb_mb_wait, (unsigned seenSeq, int ms, int headerBytes), {
+	var lb = Module.linkbus;
+	if (!lb || !lb.mailbox || ms <= 0) return;
+	var i32 = lb._mbI32 || (lb._mbI32 = new Int32Array(lb.mailbox, 0, headerBytes >> 2));
+	try {
+		Atomics.wait(i32, 0, seenSeq | 0, ms);
+	} catch (e) {
+		// Atomics.wait is not allowed on the main thread: do not block.
+	}
+});
+
+EM_JS(void, lb_mb_push, (const unsigned char *src, int length, int txOffset, int headerBytes), {
+	var lb = Module.linkbus;
+	if (!lb || !lb.mailbox) return;
+	var i32 = lb._mbI32 || (lb._mbI32 = new Int32Array(lb.mailbox, 0, headerBytes >> 2));
+	new Uint8Array(lb.mailbox, txOffset, length).set(HEAPU8.subarray(src, src + length));
+	Atomics.store(i32, 7, length);
+	var seq = Atomics.add(i32, 3, 1) + 1;
+	Atomics.notify(i32, 3);
+	var msg = { type: 'linkbus-tx', seq: seq };
+	if (lb.post) lb.post(msg);
+	else if (typeof postMessage === 'function' && typeof window === 'undefined') postMessage(msg);
+});
+
+EM_JS(int, lb_mb_error, (int headerBytes), {
+	var lb = Module.linkbus;
+	if (!lb || !lb.mailbox) return 1;
+	var i32 = lb._mbI32 || (lb._mbI32 = new Int32Array(lb.mailbox, 0, headerBytes >> 2));
+	return Atomics.load(i32, 2) !== 0 ? 1 : 0;
+});
+
+// ---------------------------------------------------------------------------
+// JS imports: multiboard cabinet
+// ---------------------------------------------------------------------------
+
+EM_JS(int, lb_cab_ok, (), {
+	var lb = Module.linkbus;
+	return lb && lb.cabinet ? 1 : 0;
+});
+
+EM_JS(int, lb_cab_hdr, (int op, int index, int value), {
+	// op 0 load, 1 store, 2 or, 3 and (returns new value for 2, 3)
+	var lb = Module.linkbus;
+	var i32 = lb._cabI32 || (lb._cabI32 = new Int32Array(lb.cabinet, 0, 16));
+	switch (op) {
+	case 0: return Atomics.load(i32, index);
+	case 1: Atomics.store(i32, index, value); return value;
+	case 2: return Atomics.or(i32, index, value) | value;
+	case 3: return Atomics.and(i32, index, value) & value;
+	}
+	return 0;
+});
+
+EM_JS(int, lb_cab_read16, (unsigned word, int dataOffset), {
+	var lb = Module.linkbus;
+	var u16 = lb._cabU16 || (lb._cabU16 = new Uint16Array(lb.cabinet, dataOffset));
+	return u16[word];
+});
+
+EM_JS(void, lb_cab_write16, (unsigned word, int value, int dataOffset), {
+	var lb = Module.linkbus;
+	var u16 = lb._cabU16 || (lb._cabU16 = new Uint16Array(lb.cabinet, dataOffset));
+	u16[word] = value;
+});
+
+EM_JS(void, lb_cab_copy_out, (unsigned word, void *dst, int bytes, int dataOffset), {
+	var lb = Module.linkbus;
+	HEAPU8.set(new Uint8Array(lb.cabinet, dataOffset + word * 2, bytes), dst);
+});
+
+// Generation barrier; returns 0 ok, 1 timeout, 2 exit (slave).
+EM_JS(int, lb_cab_barrier, (int boardId, int timeoutMs), {
+	var lb = Module.linkbus;
+	var i32 = lb._cabI32 || (lb._cabI32 = new Int32Array(lb.cabinet, 0, 16));
+	if (boardId !== 0 && Atomics.load(i32, 1) !== 0) return 2;
+	var g = Atomics.load(i32, 2);
+	var bit = 1 << boardId;
+	var arrived = Atomics.or(i32, 3, bit) | bit;
+	var mask = Atomics.load(i32, 4);
+	if ((arrived & mask) === mask) {
+		Atomics.store(i32, 3, 0);
+		Atomics.add(i32, 2, 1);
+		Atomics.notify(i32, 2);
+		return 0;
+	}
+	var r;
+	try {
+		r = Atomics.wait(i32, 2, g, timeoutMs);
+	} catch (e) {
+		r = 'timed-out';	// main thread: cannot block
+	}
+	if (boardId !== 0 && Atomics.load(i32, 1) !== 0) return 2;
+	return r === 'timed-out' ? 1 : 0;
+});
+
+EM_JS(void, lb_cab_start_partners, (int boardId, int slaves), {
+	var lb = Module.linkbus;
+	var msg = { type: 'linkbus-start-partners', boardId: boardId, slaves: slaves };
+	if (lb && lb.post) lb.post(msg);
+	else if (typeof postMessage === 'function' && typeof window === 'undefined') postMessage(msg);
+});
+
+EM_JS(void, lb_cab_notify, (), {
+	var lb = Module.linkbus;
+	var i32 = lb._cabI32 || (lb._cabI32 = new Int32Array(lb.cabinet, 0, 16));
+	Atomics.notify(i32, 2);
+});
+
+namespace linkbus
+{
+
+namespace {
+
+class JsMailboxIo : public MailboxIo
+{
+public:
+	u32 pullLatest(u8 *dst, u32 capacity, u32 *seqOut) override {
+		return (u32)lb_mb_pull(dst, (int)capacity, seqOut,
+				(int)MailboxLayout::headerBytes, (int)MailboxLayout::bufferBytes);
+	}
+	void waitSeq(u32 seenSeq, u32 ms) override {
+		lb_mb_wait(seenSeq, (int)ms, (int)MailboxLayout::headerBytes);
+	}
+	void push(const u8 *frame, u32 length) override {
+		lb_mb_push(frame, (int)length, (int)MailboxLayout::txBuffer, (int)MailboxLayout::headerBytes);
+	}
+	bool linkError() override {
+		return lb_mb_error((int)MailboxLayout::headerBytes) != 0;
+	}
+};
+
+// i32 indexes of MultiboardSabLayout
+constexpr int kStatus = MultiboardSabLayout::status / 4;
+constexpr int kExit = MultiboardSabLayout::exit / 4;
+constexpr int kBoardMask = MultiboardSabLayout::boardMask / 4;
+constexpr int kArrived = MultiboardSabLayout::arrived / 4;
+constexpr int kData = (int)MultiboardSabLayout::data;
+
+class SabBoard : public MultiboardBackend
+{
+public:
+	explicit SabBoard(int boardId) : id(boardId)
+	{
+		if (id == 0)
+		{
+			// Native master constructor: fresh shared state, only the master
+			// takes part until startPartners().
+			lb_cab_hdr(1, kStatus, 0);
+			lb_cab_hdr(1, kExit, 0);
+			lb_cab_hdr(1, kArrived, 0);
+			lb_cab_hdr(1, kBoardMask, 1);
+		}
+	}
+
+	int boardId() const override { return id; }
+
+	u16 status() const override { return (u16)lb_cab_hdr(0, kStatus, 0); }
+	void setStatus(u16 v) override { lb_cab_hdr(1, kStatus, v); }
+	void statusOr(u16 bits) override { lb_cab_hdr(2, kStatus, bits); }
+	void statusAnd(u16 bits) override { lb_cab_hdr(3, kStatus, (int)(0xffff0000u | bits)); }
+
+	u16 read16(u32 i) const override { return (u16)lb_cab_read16(i & (kMbDataWords - 1), kData); }
+	void write16(u32 i, u16 v) override { lb_cab_write16(i & (kMbDataWords - 1), v, kData); }
+	u32 read32(u32 i) const override
+	{
+		i &= kMbDataWords - 1;
+		u32 v = read16(i);
+		if (i + 1 < kMbDataWords)
+			v |= (u32)read16(i + 1) << 16;
+		return v;
+	}
+	void write32(u32 i, u32 v) override
+	{
+		i &= kMbDataWords - 1;
+		write16(i, (u16)v);
+		if (i + 1 < kMbDataWords)
+			write16(i + 1, (u16)(v >> 16));
+	}
+	void copyOut(u32 i, void *dst, u32 bytes) const override
+	{
+		i &= kMbDataWords - 1;
+		if (bytes > (kMbDataWords - i) * 2)
+			bytes = (kMbDataWords - i) * 2;
+		lb_cab_copy_out(i, dst, (int)bytes, kData);
+	}
+
+	BarrierResult barrier(u32 timeoutMs) override
+	{
+		switch (lb_cab_barrier(id, (int)timeoutMs))
+		{
+		case 0: return BarrierResult::Ok;
+		case 2: return BarrierResult::Exit;
+		default: return BarrierResult::Timeout;
+		}
+	}
+
+	void requestExit() override
+	{
+		lb_cab_hdr(1, kExit, 1);
+		lb_cab_notify();
+	}
+
+	void startPartners(int slaves) override
+	{
+		if (slaves < 0) slaves = 0;
+		if (slaves > kMbMaxBoards - 1) slaves = kMbMaxBoards - 1;
+		lb_cab_hdr(1, kArrived, 0);
+		lb_cab_hdr(1, kBoardMask, (1 << (slaves + 1)) - 1);
+		lb_cab_start_partners(id, slaves);
+	}
+
+private:
+	int id;
+};
+
+FramePacer pacer;
+
+} // namespace
+
+std::unique_ptr<MultiboardBackend> makeSabMultiboardBackend(int boardId)
+{
+	if (!lb_cab_ok())
+		return nullptr;
+	return std::make_unique<SabBoard>(boardId);
+}
+
