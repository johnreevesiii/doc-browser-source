+// ---------------------------------------------------------------------------
+// Stale and missing frames
+// ---------------------------------------------------------------------------
+
+TEST(hub_stale_before_first_frame_and_without_tick)
+{
+	const int n = 5;
+	const u32 S = 8;
+	InMemoryHub hub(n, Edition::A, 0);
+	auto s0 = hub.attach(0);
+	auto s1 = hub.attach(1);
+	CHECK(hub.attach(1) == nullptr);	// seat already taken
+	std::vector<u8> rx(S * n, 0x77);
+	hub.tick();
+	TakeResult r = s1->take(rx.data(), S, n, 0);
+	CHECK(!r.fresh);
+	CHECK(!r.error);
+	CHECK_EQ(s1->stats().stale, 1u);
+	auto d0 = slotOf(0, S);
+	s0->publish(d0.data(), S, n, 10);
+	// Published but no hub tick yet: still stale.
+	r = s1->take(rx.data(), S, n, 0);
+	CHECK(!r.fresh);
+	CHECK_EQ(rx[0], 0x77);
+	hub.tick();
+	r = s1->take(rx.data(), S, n, 0);
+	CHECK(r.fresh);
+	CHECK_EQ(r.packetNumber, 10);		// predecessor of 1 is 0
+	CHECK(slotIs(&rx[0], 0, S));		// k = 1 is node 0
+	CHECK_EQ(rx[S], 0x00);				// k = 2 is node 4: nothing yet, hub start-up zero
+	// Taking again without a new tick: stale, bytes unchanged.
+	std::vector<u8> before = rx;
+	r = s1->take(rx.data(), S, n, 0);
+	CHECK(!r.fresh);
+	CHECK(rx == before);
+	// A tick with no new publish delivers nothing new.
+	hub.tick();
+	r = s1->take(rx.data(), S, n, 0);
+	CHECK(!r.fresh);
+	CHECK_EQ(s1->stats().stale, 4u);
+	CHECK_EQ(s1->stats().taken, 1u);
+}
+
+TEST(hub_missing_node_keeps_old_slot_and_transcnt)
+{
+	const int n = 5;
+	const u32 S = 8;
+	InMemoryHub hub(n, Edition::A, 0);
+	std::vector<std::unique_ptr<RingBackend>> seats;
+	for (int i = 0; i < n; i++)
+		seats.push_back(hub.attach(i));
+	auto publishAll = [&](u32 g, int skip) {
+		for (int i = 0; i < n; i++)
+			if (i != skip)
+			{
+				auto s = slotOf(i, S, g);
+				seats[i]->publish(s.data(), S, n, (u16)(g * 10 + i));
+			}
+	};
+	std::vector<std::vector<u8>> rx(n, std::vector<u8>(S * n, 0));
+	publishAll(1, -1);
+	hub.tick();
+	for (int t = 0; t < n; t++)
+		CHECK(seats[t]->take(rx[t].data(), S, n, 0).fresh);
+	// Node 2 goes missing for generation 2.
+	publishAll(2, 2);
+	hub.tick();
+	for (int t = 0; t < n; t++)
+	{
+		TakeResult r = seats[t]->take(rx[t].data(), S, n, 0);
+		CHECK(r.fresh);
+		const int pred = (t + n - 1) % n;
+		// Seat 3's predecessor is node 2: transcnt stays at generation 1.
+		CHECK_EQ(r.packetNumber, (u16)((pred == 2 ? 1 : 2) * 10 + pred));
+		for (int k = 1; k <= n; k++)
+		{
+			int src = rxSourceNode(t, n, k);
+			CHECK(slotIs(&rx[t][S * (k - 1)], src, S, src == 2 ? 1 : 2));
+		}
+	}
+}
