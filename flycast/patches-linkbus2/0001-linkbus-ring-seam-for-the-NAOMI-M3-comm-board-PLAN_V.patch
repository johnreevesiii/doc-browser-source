+// ---------------------------------------------------------------------------
+// Multiboard in-memory cabinet
+// ---------------------------------------------------------------------------
+
+TEST(cabinet_barrier_and_exit)
+{
+	InMemoryCabinet cab;
+	std::vector<int> started;
+	cab.partnerStarter = [&](int id) { started.push_back(id); };
+	auto master = cab.attach(0);
+	auto slave = cab.attach(1);
+	// Before startPartners only the master takes part.
+	CHECK(master->barrier(0) == BarrierResult::Ok);
+	master->startPartners(1);
+	CHECK_EQ(started.size(), (size_t)1);
+	CHECK_EQ(started.empty() ? -1 : started[0], 1);
+	// Master arrives first and times out (single thread), slave completes.
+	CHECK(master->barrier(0) == BarrierResult::Timeout);
+	CHECK(slave->barrier(0) == BarrierResult::Ok);
+	// Both arrive again in the other order.
+	CHECK(slave->barrier(0) == BarrierResult::Timeout);
+	CHECK(master->barrier(0) == BarrierResult::Ok);
+	// Status and bank are shared.
+	master->setStatus(0x0003);
+	slave->statusOr(0x10 << 1);
+	CHECK_EQ(master->status(), 0x23);
+	slave->statusAnd((u16)~(0x10 << 1));
+	CHECK_EQ(master->status(), 0x03);
+	master->write32(0x100, 0xAABBCCDD);
+	CHECK_EQ(slave->read16(0x100), 0xCCDD);
+	CHECK_EQ(slave->read16(0x101), 0xAABB);
+	CHECK_EQ(slave->read32(0x100), 0xAABBCCDDu);
+	CHECK_EQ(slave->read16(0x100 + kMbDataWords), 0xCCDD);	// masked
+	u32 out = 0;
+	slave->copyOut(0x100, &out, 4);
+	CHECK_EQ(out, 0xAABBCCDDu);
+	// Exit: the slave's next barrier reports it.
+	master->requestExit();
+	CHECK(slave->barrier(0) == BarrierResult::Exit);
+}
