+	// The next good frame is accepted.
+	auto good = makeAssembled(2, n, S, Edition::A, 5, 2, 41);
+	mailboxDeliver(region.data(), good.data(), (u32)good.size());
+	r = ring->take(rx.data(), S, n, 0);
+	CHECK(r.fresh);
+	CHECK_EQ(r.packetNumber, 41);
+	CHECK(slotIs(&rx[0], rxSourceNode(2, n, 1), S));
+}
