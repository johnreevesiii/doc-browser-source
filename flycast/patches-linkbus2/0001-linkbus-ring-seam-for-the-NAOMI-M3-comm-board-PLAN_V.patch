+	auto ok = makeSlotFrame(2, 5, 16, Edition::A, 77, 1);
+	CHECK(checkSlotFrame(ok.data(), (u32)ok.size(), e, nullptr) == FrameCheck::Ok);
+	auto b = makeSlotFrame(2, 5, 16, Edition::B, 77, 1);
+	CHECK(checkSlotFrame(b.data(), (u32)b.size(), e, nullptr) == FrameCheck::BadEdition);
+	auto unk = makeSlotFrame(2, 5, 16, Edition::Unknown, 77, 1);
+	CHECK(checkSlotFrame(unk.data(), (u32)unk.size(), e, nullptr) == FrameCheck::BadEdition);
+	auto sess = makeSlotFrame(2, 5, 16, Edition::A, 78, 1);
+	CHECK(checkSlotFrame(sess.data(), (u32)sess.size(), e, nullptr) == FrameCheck::BadHeader);
+	auto size = makeSlotFrame(2, 5, 32, Edition::A, 77, 1);
+	CHECK(checkSlotFrame(size.data(), (u32)size.size(), e, nullptr) == FrameCheck::BadSize);
+	CHECK(checkSlotFrame(ok.data(), (u32)ok.size() - 1, e, nullptr) == FrameCheck::BadSize);
+	auto node = makeSlotFrame(5, 5, 16, Edition::A, 77, 1);
+	CHECK(checkSlotFrame(node.data(), (u32)node.size(), e, nullptr) == FrameCheck::BadHeader);
+
+	e.targetNode = 3;
+	auto a = makeAssembled(3, 5, 16, Edition::A, 77, 10, 4);
+	CHECK(checkAssembledFrame(a.data(), (u32)a.size(), e, nullptr) == FrameCheck::Ok);
+	auto ab = makeAssembled(3, 5, 16, Edition::B, 77, 10, 4);
+	CHECK(checkAssembledFrame(ab.data(), (u32)ab.size(), e, nullptr) == FrameCheck::BadEdition);
+	auto at = makeAssembled(2, 5, 16, Edition::A, 77, 10, 4);
+	CHECK(checkAssembledFrame(at.data(), (u32)at.size(), e, nullptr) == FrameCheck::BadHeader);
+	auto an = makeAssembled(3, 6, 16, Edition::A, 77, 10, 4);
+	CHECK(checkAssembledFrame(an.data(), (u32)an.size(), e, nullptr) == FrameCheck::BadSize);
+}
+
+TEST(edition_tag_refusal_hub)
+{
+	const int n = 5;
+	const u32 S = 12;
+	InMemoryHub hub(n, Edition::A, 0, 99);
+	std::vector<std::unique_ptr<RingBackend>> seats;
+	for (int i = 0; i < n; i++)
+		seats.push_back(hub.attach(i, i == 3 ? Edition::B : Edition::A));
+	for (int i = 0; i < n; i++)
+	{
+		auto s = slotOf(i, S);
+		CHECK(seats[i]->publish(s.data(), S, n, (u16)(100 + i)));
+	}
+	CHECK_EQ(hub.stats().badEdition, 1u);
+	CHECK_EQ(hub.stats().accepted, 4u);
+	CHECK_EQ(seats[3]->stats().badEdition, 1u);
+	hub.tick();
+	// Seat 1: node 3's slot never arrived. The hub's view of it is still the
+	// start-up zero (native comm RAM also starts zeroed), and stays so.
+	std::vector<u8> rx(S * n, 0xEE);
+	TakeResult r = seats[1]->take(rx.data(), S, n, 0);
+	CHECK(r.fresh);
+	for (int k = 1; k <= n; k++)
+	{
+		int src = rxSourceNode(1, n, k);
+		if (src == 3)
+			CHECK_EQ(rx[S * (k - 1)], 0x00);
+		else
+			CHECK(slotIs(&rx[S * (k - 1)], src, S));
+	}
+	// Seat 3 (edition B) refuses the hub's edition A frame.
+	std::vector<u8> rx3(S * n, 0x55);
+	TakeResult r3 = seats[3]->take(rx3.data(), S, n, 0);
+	CHECK(!r3.fresh);
+	CHECK(!r3.error);
+	CHECK_EQ(seats[3]->stats().badEdition, 2u);
+	CHECK_EQ(rx3[0], 0x55);
+	// A foreign frame injected on the raw wire is refused too.
+	auto foreign = makeSlotFrame(2, n, S, Edition::B, 99, 7);
+	CHECK(hub.submit(foreign.data(), (u32)foreign.size()) == FrameCheck::BadEdition);
+	CHECK_EQ(hub.stats().badEdition, 2u);
+}
