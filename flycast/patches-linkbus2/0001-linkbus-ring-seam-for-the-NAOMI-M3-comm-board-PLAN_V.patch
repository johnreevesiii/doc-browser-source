+// ---------------------------------------------------------------------------
+// FramePacer
+// ---------------------------------------------------------------------------
+
+void FramePacer::observeHubTick(u32 tick)
+{
+	if (!haveTick)
+	{
+		haveTick = true;
+		lastTick = tick;
+		creditTicks += 1;
+	}
+	else
+	{
+		// Signed distance so that a stale or repeated tick adds nothing.
+		const int delta = (int)(tick - lastTick);
+		if (delta <= 0)
+			return;
+		lastTick = tick;
+		creditTicks += delta;
+	}
+	if (creditTicks > (int)cfg.maxBacklog)
+	{
+		st.droppedCredit += (u32)(creditTicks - (int)cfg.maxBacklog);
+		creditTicks = (int)cfg.maxBacklog;
+	}
+}
+
+u32 FramePacer::framesToRun()
+{
+	if (!haveTick)
+		return 1;	// no link information yet: free run, as before the first packet
+	if (creditTicks <= 0)
+	{
+		if (holdRun >= cfg.maxHoldFrames)
+		{
+			holdRun = 0;
+			st.forced++;
+			return 1;
+		}
+		holdRun++;
+		st.held++;
+		return 0;
+	}
+	holdRun = 0;
+	const u32 n = std::min<u32>((u32)creditTicks, std::max<u32>(cfg.maxCatchUp, 1));
+	st.caughtUp += n - 1;
+	return n;
+}
+
+void FramePacer::onFrameRun()
+{
+	creditTicks--;
+	// A forced frame borrows from the next tick; never run up an unbounded debt.
+	if (creditTicks < -(int)cfg.maxBacklog)
+		creditTicks = -(int)cfg.maxBacklog;
+}
+
+void FramePacer::reset()
+{
+	st = {};
+	haveTick = false;
+	lastTick = 0;
+	creditTicks = 0;
+	holdRun = 0;
+}
+
+// ---------------------------------------------------------------------------
+// InMemoryHub
+// ---------------------------------------------------------------------------
+//
+// Timing: a slot frame published while the hub is at tick T is stamped T.
+// tick() advances to T + 1 and delivers, for every node, the newest snapshot
+// with stamp + 1 + L <= T + 1. So L = 0 delivers on the next tick and every
+// node and every seat gets the same delay (PLAN_V2 3.2).
+
+struct InMemoryHub::Impl
+{
+	struct Snapshot
+	{
+		u32 stamp;
+		u32 id;				// per node, increasing
+		u16 packetNumber;
+		std::vector<u8> bytes;
+	};
+	struct Seat
+	{
+		bool attached = false;
+		std::vector<u8> rx;				// persistent: absent slots keep old bytes
+		std::vector<u32> usedId;		// snapshot id used per node, 0 = none
+		std::vector<u8> pending;		// assembled frame not yet taken
+		bool hasPending = false;
+		u32 droppedPending = 0;
+		u16 prevPacketNumber = 0;
+	};
+
+	int n;
+	Edition edition;
+	u32 delay;
+	u32 sessionTag;
+	u32 tick = 0;
+	u32 slotSize = 0;
+	bool failed = false;
+	std::vector<std::deque<Snapshot>> nodes;
+	std::vector<u32> nextId;
+	std::vector<Seat> seats;
+	Stats stats;
+	mutable std::mutex mutex;
+	std::condition_variable cond;
+
+	Impl(int n, Edition edition, u32 delay, u32 sessionTag)
+		: n(n), edition(edition), delay(delay), sessionTag(sessionTag),
+		  nodes(n), nextId(n, 1), seats(n) {}
+
+	const Snapshot *delayed(int node) const
+	{
+		const Snapshot *best = nullptr;
+		for (const Snapshot& s : nodes[node])
+			if (s.stamp + 1 + delay <= tick)
+				best = &s;
+		return best;
+	}
+
+	void prune()
+	{
+		for (int i = 0; i < n; i++)
+		{
+			auto& q = nodes[i];
+			while (q.size() >= 2 && q[1].stamp + 1 + delay <= tick)
+				q.pop_front();
+		}
+	}
+
+	FrameCheck submit(const u8 *bytes, u32 size)
+	{
+		WireExpect expect;
+		expect.edition = edition;
+		expect.sessionTag = sessionTag;
+		expect.slotCount = n;
+		expect.slotSize = slotSize;
+		SlotFrameHeader h;
+		FrameCheck c = checkSlotFrame(bytes, size, expect, &h);
+		if (c != FrameCheck::Ok)
+		{
+			if (c == FrameCheck::BadEdition) stats.badEdition++;
+			else if (c == FrameCheck::BadSize) stats.badSize++;
+			else stats.badHeader++;
+			return c;
+		}
+		slotSize = h.slotSize;
+		Snapshot s;
+		s.stamp = tick;
+		s.id = nextId[h.nodeId]++;
+		s.packetNumber = h.packetNumber;
+		s.bytes.assign(bytes + sizeof(h), bytes + size);
+		auto& q = nodes[h.nodeId];
+		// Several frames from one node within one hub tick: latest wins.
+		if (!q.empty() && q.back().stamp == tick)
+			q.back() = std::move(s);
+		else
+			q.push_back(std::move(s));
+		stats.accepted++;
+		return FrameCheck::Ok;
+	}
+
+	void doTick()
+	{
+		tick++;
+		if (slotSize == 0)
+			return;
+		const u32 S = slotSize;
+		std::vector<const Snapshot *> snap(n);
+		for (int i = 0; i < n; i++)
+			snap[i] = delayed(i);
+		for (int t = 0; t < n; t++)
+		{
+			Seat& seat = seats[t];
+			if (!seat.attached)
+				continue;
+			if (seat.rx.size() != S * (u32)n)
+				seat.rx.assign(S * (u32)n, 0);
+			if (seat.usedId.size() != (size_t)n)
+				seat.usedId.assign(n, 0);
+			bool changed = false;
+			for (int i = 0; i < n; i++)
+				if (snap[i] != nullptr && snap[i]->id != seat.usedId[i])
+					changed = true;
+			if (!changed)
+				continue;	// nothing new for this seat: it will see a stale take()
+			std::vector<const u8 *> latest(n);
+			for (int i = 0; i < n; i++)
+			{
+				latest[i] = snap[i] != nullptr ? snap[i]->bytes.data() : nullptr;
+				seat.usedId[i] = snap[i] != nullptr ? snap[i]->id : 0;
+			}
+			assembleRx(latest.data(), n, t, S, seat.rx.data());
+			const int pred = rxSourceNode(t, n, 1);
+			if (snap[pred] != nullptr)
+				seat.prevPacketNumber = snap[pred]->packetNumber;
+
+			AssembledFrameHeader h;
+			h.magic = kAssembledMagic;
+			h.version = kWireVersion;
+			h.edition = (u8)edition;
+			h.targetNode = (u8)t;
+			h.slotCount = (u8)n;
+			h.slotSize = (u16)S;
+			h.prevPacketNumber = seat.prevPacketNumber;
+			h.hubTick = tick;
+			h.releaseFrame = tick;
+			h.sessionTag = sessionTag;
+			if (seat.hasPending)
+				seat.droppedPending++;
+			seat.pending.resize(sizeof(h) + seat.rx.size());
+			std::memcpy(seat.pending.data(), &h, sizeof(h));
+			std::memcpy(seat.pending.data() + sizeof(h), seat.rx.data(), seat.rx.size());
+			seat.hasPending = true;
+		}
+		prune();
+		cond.notify_all();
+	}
+};
+
+namespace {
+
+class InMemorySeat : public RingBackend
+{
+public:
+	InMemorySeat(InMemoryHub::Impl& hub, int slotId, Edition edition)
+		: hub(hub)
+	{
+		r.slotId = slotId;
+		r.slotCount = hub.n;
+		r.edition = edition;
+	}
+
+	~InMemorySeat() override {
+		shutdown();
+	}
+
+	RingRole role() const override { return r; }
+
+	bool publish(const u8 *txBase, u32 slotSize, u32 slotCount, u16 packetNumber) override
+	{
+		if (closed)
+			return false;
+		std::vector<u8> frame = encodeSlotFrame(txBase, slotSize, r.slotId, (int)slotCount,
+				r.edition, packetNumber, localFrame++, hub.sessionTag);
+		std::lock_guard<std::mutex> _(hub.mutex);
+		st.published++;
+		// A refused frame (foreign edition, bad size) is dropped and counted by
+		// the hub; it is not a link error, as a stray UDP packet is not.
+		FrameCheck c = hub.submit(frame.data(), (u32)frame.size());
+		countCheck(c, st);
+		return true;
+	}
+
+	TakeResult take(u8 *rxBase, u32 slotSize, u32 slotCount, u32 waitMs) override
+	{
+		TakeResult res;
+		std::unique_lock<std::mutex> lock(hub.mutex);
+		Seat& seat = hub.seats[r.slotId];
+		if (hub.failed || closed) {
+			res.error = true;
+			return res;
+		}
+		if (!seat.hasPending && waitMs > 0)
+			hub.cond.wait_for(lock, std::chrono::milliseconds(waitMs),
+					[&] { return seat.hasPending || hub.failed; });
+		if (hub.failed) {
+			res.error = true;
+			return res;
+		}
+		st.dropped += seat.droppedPending;
+		seat.droppedPending = 0;
+		if (!seat.hasPending) {
+			st.stale++;
+			return res;
+		}
+		seat.hasPending = false;
+		WireExpect expect;
+		expect.edition = r.edition;
+		expect.sessionTag = hub.sessionTag;
+		expect.slotCount = (int)slotCount;
+		expect.slotSize = slotSize;
+		expect.targetNode = r.slotId;
+		AssembledFrameHeader h;
+		FrameCheck c = checkAssembledFrame(seat.pending.data(), (u32)seat.pending.size(), expect, &h);
+		if (c != FrameCheck::Ok || (haveTick && (int)(h.hubTick - lastTick) <= 0))
+		{
+			countCheck(c, st);
+			st.stale++;
+			return res;
+		}
+		haveTick = true;
+		lastTick = h.hubTick;
+		std::memcpy(rxBase, seat.pending.data() + sizeof(h), rxRegionSize(slotSize, (int)slotCount));
+		st.taken++;
+		res.fresh = true;
+		res.packetNumber = h.prevPacketNumber;
+		res.hubTick = h.hubTick;
+		return res;
+	}
+
+	bool peekHubTick(u32 *tick) override
+	{
+		std::lock_guard<std::mutex> _(hub.mutex);
+		Seat& seat = hub.seats[r.slotId];
+		if (!seat.hasPending)
+		{
+			if (!haveTick)
+				return false;
+			*tick = lastTick;
+			return true;
+		}
+		AssembledFrameHeader h;
+		std::memcpy(&h, seat.pending.data(), sizeof(h));
+		*tick = h.hubTick;
+		return true;
+	}
+
+	void shutdown() override
+	{
+		if (closed)
+			return;
+		closed = true;
+		std::lock_guard<std::mutex> _(hub.mutex);
+		hub.seats[r.slotId].attached = false;
+		hub.seats[r.slotId].hasPending = false;
+	}
+
+	Stats stats() const override { return st; }
+
+private:
+	using Seat = InMemoryHub::Impl::Seat;
+	InMemoryHub::Impl& hub;
+	RingRole r;
+	Stats st;
+	u32 localFrame = 0;
+	bool haveTick = false;
+	u32 lastTick = 0;
+	bool closed = false;
+};
+
+} // namespace
