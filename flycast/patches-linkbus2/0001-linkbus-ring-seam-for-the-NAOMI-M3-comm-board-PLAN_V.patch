+// End to end: every seat runs the NaomiM3Comm::vblank order (take, then
+// publish) with the hub ticking once per frame, L = 1.
+TEST(hub_vblank_loop_steady_state)
+{
+	const int n = 5;
+	const u32 S = 10;
+	InMemoryHub hub(n, Edition::A, 1);
+	std::vector<std::unique_ptr<RingBackend>> seats;
+	for (int i = 0; i < n; i++)
+		seats.push_back(hub.attach(i));
+	struct Board { std::vector<u8> comm; u16 transcnt = 0; u16 packet = 0; };
+	std::vector<Board> boards(n);
+	for (auto& b : boards)
+		b.comm.assign(S * (n + 1), 0);
+	for (u32 frame = 1; frame <= 20; frame++)
+	{
+		for (int i = 0; i < n; i++)
+		{
+			Board& b = boards[i];
+			auto own = slotOf(i, S, frame);
+			std::copy(own.begin(), own.end(), b.comm.begin());
+			TakeResult r = seats[i]->take(&b.comm[S], S, n, 0);
+			CHECK(!r.error);
+			if (r.fresh)
+				b.transcnt = r.packetNumber;
+			seats[i]->publish(&b.comm[0], S, n, b.packet++);
+		}
+		hub.tick();
+	}
+	// Frame 20's take saw the hub state after tick 19, which with L = 1
+	// carries the slots published in frame 18 (stamp 17, visible at 19).
+	for (int t = 0; t < n; t++)
+	{
+		for (int k = 1; k <= n; k++)
+			CHECK(slotIs(&boards[t].comm[S * k], rxSourceNode(t, n, k), S, 18));
+		CHECK_EQ(boards[t].transcnt, 17);
+		CHECK_EQ(seats[t]->stats().dropped, 0u);
+	}
+}
