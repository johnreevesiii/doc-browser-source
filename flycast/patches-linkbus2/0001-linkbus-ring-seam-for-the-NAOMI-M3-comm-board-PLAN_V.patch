+
+#define CHECK(cond) do { checks++; if (!(cond)) { failures++; \
+	std::printf("  FAIL %s:%d [%s] %s\n", __FILE__, __LINE__, currentTest, #cond); } } while (0)
+#define CHECK_EQ(a, b) do { checks++; auto _a = (a); auto _b = (b); if (!(_a == _b)) { failures++; \
+	std::printf("  FAIL %s:%d [%s] %s == %s (%lld vs %lld)\n", __FILE__, __LINE__, currentTest, #a, #b, \
+		(long long)_a, (long long)_b); } } while (0)
+
+#define TEST(name) static void name(); static Registrar reg_##name(#name, name); static void name()
+
+struct Registrar;
+static std::vector<std::pair<const char *, void (*)()>>& registry() {
+	static std::vector<std::pair<const char *, void (*)()>> r;
+	return r;
+}
+struct Registrar {
+	Registrar(const char *n, void (*f)()) { registry().emplace_back(n, f); }
+};
