+	auto s0 = hub.attach(0), s1 = hub.attach(1);
+	std::vector<u8> tx(S * n, 0x12);
+	s1->publish(tx.data(), S, n, 5);
+	// Seat 0's transport carries a frame claiming to be node 1 (same tick).
+	auto imp = slotFrameLf(1, n, S, 1000, 0x77);
+	CHECK(hub.submit(0, imp.data(), (u32)imp.size()) == FrameCheck::BadHeader);
+	CHECK(hub.submit(-1, imp.data(), (u32)imp.size()) == FrameCheck::BadHeader);
+	CHECK(hub.submit(n, imp.data(), (u32)imp.size()) == FrameCheck::BadHeader);
+	CHECK_EQ(hub.stats().badHeader, 3u);
+	hub.tick();
+	GuardedRx rx(S, n);
+	CHECK(s0->take(rx.base(), S, n, 0).fresh);
+	// Node 0: k = 2 is node 1, which must hold seat 1's bytes.
+	CHECK_EQ(rx.base()[S * 1], 0x12);
+	CHECK(rx.canariesIntact());
