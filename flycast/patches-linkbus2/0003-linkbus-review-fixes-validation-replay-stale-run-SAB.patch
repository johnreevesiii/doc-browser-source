+	CHECK(ring->peekHubTick(&t));
+	CHECK_EQ(t, 100u);
+	pacer.observeHubTick(t);
+	// Each wrong field alone, with a far-ahead tick.
+	const u32 far = 100 + 1000000;
+	std::vector<std::vector<u8>> bad;
+	bad.push_back(asmFill(Edition::B, session, me, n, S, far, 0, 0));
+	bad.push_back(asmFill(Edition::A, session ^ 0xFF, me, n, S, far, 0, 0));
+	bad.push_back(asmFill(Edition::A, session, me + 1, n, S, far, 0, 0));
+	bad.push_back(asmFill(Edition::A, session, me, n + 1, S, far, 0, 0));
+	{
+		auto f = asmFill(Edition::A, session, me, n, S, far, 0, 0);
