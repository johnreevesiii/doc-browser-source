+	InMemoryHub hub(n, Edition::A, 0, 77);
+	auto s0 = hub.attach(0), s1 = hub.attach(1), s2 = hub.attach(2);
+	auto evil = slotFrameLf(2, n, 0xFFFF, 0, 0x99);
