+
+static std::vector<u8> slotFrameLf(int node, int n, u32 S, u32 localFrame, u8 fill, u32 session = 77)
+{
+	auto f = makeSlotFrame(node, n, S, Edition::A, session, 1);
+	SlotFrameHeader h;
+	std::memcpy(&h, f.data(), sizeof(h));
+	h.localFrame = localFrame;
+	std::memcpy(f.data(), &h, sizeof(h));
+	std::memset(f.data() + sizeof(h), fill, S);
+	return f;
+}
+
+// comm_ram-like buffer with canaries around the RX region.
+struct GuardedRx
+{
+	std::vector<u8> mem;
+	u32 S;
+	int n;
+	GuardedRx(u32 S, int n) : mem(0x100 + S * (n + 1) + 4096, 0xCC), S(S), n(n) {}
+	u8 *base() { return &mem[rxSlotOffset(S, 1)]; }
+	bool canariesIntact() const
+	{
+		for (u32 i = rxSlotOffset(S, 1) + S * n; i < mem.size(); i++)
+			if (mem[i] != 0xCC) return false;
+		for (u32 i = 0; i < rxSlotOffset(S, 1); i++)
+			if (mem[i] != 0xCC) return false;
+		return true;
+	}
+	bool rxIs(u8 v) { for (u32 i = 0; i < S * (u32)n; i++) if (base()[i] != v) return false; return true; }
+};
+
+static std::vector<u8> asmFill(Edition ed, u32 session, int target, int n, u32 S, u32 tick, u16 pn, u8 fill)
+{
+	AssembledFrameHeader h{};
+	h.magic = kAssembledMagic;
+	h.version = kWireVersion;
+	h.edition = (u8)ed;
+	h.targetNode = (u8)target;
+	h.slotCount = (u8)n;
+	h.slotSize = (u16)S;
+	h.prevPacketNumber = pn;
+	h.hubTick = tick;
+	h.releaseFrame = tick;
+	h.sessionTag = session;
+	std::vector<u8> f(sizeof(h) + (size_t)S * n, fill);
+	std::memcpy(f.data(), &h, sizeof(h));
+	return f;
+}
