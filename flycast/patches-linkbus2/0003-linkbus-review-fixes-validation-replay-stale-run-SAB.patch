+		bad.push_back(f);
+	}
+	for (auto& b : bad)
+	{
+		mailboxDeliver(region.data(), b.data(), (u32)b.size());
+		CHECK(ring->peekHubTick(&t));
+		CHECK_EQ(t, 100u);
+	}
+	// Reviewer case: legit ticks resume; the pacer runs one frame per tick.
+	u32 ran = 0;
+	for (u32 k = 0; k < 70; k++)
