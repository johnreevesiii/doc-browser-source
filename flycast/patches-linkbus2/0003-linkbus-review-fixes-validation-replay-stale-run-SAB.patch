+// Finding 5: localFrame must be strictly increasing per node.
+TEST(review5_hub_refuses_replay)
+{
+	const u32 S = 0x20;
+	const int n = 3;
+	InMemoryHub hub(n, Edition::A, 0, 77);
+	auto s0 = hub.attach(0);
+	auto f = slotFrameLf(1, n, S, 3, 0x41);
+	CHECK(hub.submit(1, f.data(), (u32)f.size()) == FrameCheck::Ok);
+	hub.tick();
+	GuardedRx rx(S, n);
+	CHECK(s0->take(rx.base(), S, n, 0).fresh);
+	// Reviewer case: the same frame again is a replay, not a new snapshot.
+	CHECK(hub.submit(1, f.data(), (u32)f.size()) == FrameCheck::BadHeader);
+	auto older = slotFrameLf(1, n, S, 2, 0x42);
+	CHECK(hub.submit(1, older.data(), (u32)older.size()) == FrameCheck::BadHeader);
+	CHECK_EQ(hub.stats().replayed, 2u);
+	hub.tick();
+	CHECK(!s0->take(rx.base(), S, n, 0).fresh);
+	auto newer = slotFrameLf(1, n, S, 4, 0x43);
+	CHECK(hub.submit(1, newer.data(), (u32)newer.size()) == FrameCheck::Ok);
+	// localFrame wraps by signed distance.
+	auto nearWrap = slotFrameLf(2, n, S, 0xFFFFFFFFu, 0x44);
+	auto wrapped = slotFrameLf(2, n, S, 0, 0x45);
+	CHECK(hub.submit(2, nearWrap.data(), (u32)nearWrap.size()) == FrameCheck::Ok);
+	CHECK(hub.submit(2, wrapped.data(), (u32)wrapped.size()) == FrameCheck::Ok);
+	// A seat attached again starts counting from 0 and is accepted.
+	{
+		auto s1 = hub.attach(1);
+		std::vector<u8> tx(S * n, 0x12);
+		s1->publish(tx.data(), S, n, 1);
+		CHECK_EQ(s1->stats().badHeader, 0u);
+	}
+	auto s1b = hub.attach(1);
+	CHECK(s1b != nullptr);
+	std::vector<u8> tx(S * n, 0x13);
+	const u32 before = hub.stats().accepted;
+	s1b->publish(tx.data(), S, n, 1);
