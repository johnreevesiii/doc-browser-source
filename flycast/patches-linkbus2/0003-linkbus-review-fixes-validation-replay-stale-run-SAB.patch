+// Finding 1: the backend destructor signals exit (Multiboard no longer does).
+TEST(review1_cabinet_destructor_signals_exit)
+{
+	InMemoryCabinet cab;
+	auto master = cab.attach(0);
+	auto slave = cab.attach(1);
+	master->startPartners(1);
+	CHECK(slave->barrier(0) == BarrierResult::Timeout);
+	master.reset();
+	CHECK(slave->barrier(0) == BarrierResult::Exit);
+}
+
+// Finding 10: no direct pointer for a masked backend; copyOut is clamped.
+TEST(review10_cabinet_direct_data_null_and_copy_clamped)
+{
+	InMemoryCabinet cab;
+	auto m = cab.attach(0);
+	CHECK(m->directData() == nullptr);
+	m->write32(kMbDataWords - 2, 0xAABBCCDD);
+	std::vector<u8> buf(64, 0xCC);
+	m->copyOut(kMbDataWords - 2, buf.data(), 64);	// what dmaStart would ask for
+	u32 v = 0;
+	std::memcpy(&v, buf.data(), 4);
+	CHECK_EQ(v, 0xAABBCCDDu);
+	bool untouched = true;
+	for (size_t i = 4; i < buf.size(); i++)
+		if (buf[i] != 0xCC) untouched = false;
+	CHECK(untouched);
+	// Unmasked high index (dmaStart srcWord) wraps into the bank.
+	m->copyOut(kMbDataWords + kMbDataWords - 2, buf.data(), 64);
+	std::memcpy(&v, buf.data(), 4);
+	CHECK_EQ(v, 0xAABBCCDDu);
+}
