+	CHECK(checkSlotFrame(ok.data(), (u32)ok.size(), e, nullptr) == FrameCheck::Ok);
+	auto over = slotFrameLf(0, 16, 0x401, 0, 1);
+	CHECK(checkSlotFrame(over.data(), (u32)over.size(), e, nullptr) == FrameCheck::BadSize);
+	auto huge = slotFrameLf(0, 16, 0xFFFF, 0, 1);
+	CHECK(checkSlotFrame(huge.data(), (u32)huge.size(), e, nullptr) == FrameCheck::BadSize);
+
+	// Reviewer case: a hostile first frame with slotSize 0xFFFF no longer
+	// teaches the hub its slot size, so honest seats still link.
+	const u32 S = 0x20;
