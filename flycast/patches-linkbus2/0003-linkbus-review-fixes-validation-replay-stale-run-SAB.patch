+// Reviewer case: hostile assembled frames never touch the RX region.
+TEST(review_mailbox_hostile_frames_leave_rx_untouched)
+{
+	const u32 S = 0x40;
+	const int n = 5;
+	const int me = 2;
+	const u32 session = 0xA5A5A5A5;
+	std::vector<u8> region(MailboxLayout::totalBytes, 0);
+	MailboxConfig cfg;
+	cfg.role = { me, n, Edition::A };
+	cfg.sessionTag = session;
+	auto ring = makeMailboxRingBackend(cfg, makeBufferMailboxIo(region.data()));
+	GuardedRx rx(S, n);
+	std::memset(rx.base(), 0x11, S * n);
+	std::vector<std::vector<u8>> bads;
+	bads.push_back(asmFill(Edition::B, session, me, n, S, 1, 7, 0xEE));
+	bads.push_back(asmFill(Edition::A, session ^ 1, me, n, S, 1, 7, 0xEE));
+	bads.push_back(asmFill(Edition::A, session, me + 1, n, S, 1, 7, 0xEE));
+	bads.push_back(asmFill(Edition::A, session, me, n + 1, S, 1, 7, 0xEE));
+	bads.push_back(asmFill(Edition::A, session, me, n, S * 2, 1, 7, 0xEE));
+	bads.push_back(asmFill(Edition::A, session, me, 255, 0x40, 1, 7, 0xEE));
+	{ auto f = asmFill(Edition::A, session, me, n, S, 1, 7, 0xEE); f.resize(f.size() - 1); bads.push_back(f); }
+	{ auto f = asmFill(Edition::A, session, me, n, S, 1, 7, 0xEE); f.push_back(0); bads.push_back(f); }
+	for (auto& b : bads)
+	{
+		mailboxDeliver(region.data(), b.data(), (u32)b.size());
+		TakeResult r = ring->take(rx.base(), S, n, 0);
+		CHECK(!r.fresh);
+		CHECK(!r.error);
+		CHECK(rx.rxIs(0x11));
+		CHECK(rx.canariesIntact());
+	}
+	// Hostile length word and index in the mailbox header.
+	auto f = asmFill(Edition::A, session, me, n, S, 2, 7, 0x22);
+	mailboxDeliver(region.data(), f.data(), (u32)f.size());
+	u32 idx;
+	std::memcpy(&idx, &region[MailboxLayout::latestIndex], 4);
+	const u32 huge = 0xFFFFFFFFu;
+	std::memcpy(&region[MailboxLayout::rxLength + 4 * idx], &huge, 4);
+	CHECK(!ring->take(rx.base(), S, n, 0).fresh);
+	CHECK(rx.canariesIntact());
+	std::memcpy(&region[MailboxLayout::latestIndex], &huge, 4);
+	u32 seq;
+	std::memcpy(&seq, &region[MailboxLayout::seq], 4);
+	seq++;
+	std::memcpy(&region[MailboxLayout::seq], &seq, 4);
+	ring->take(rx.base(), S, n, 0);
+	CHECK(rx.canariesIntact());
+}
