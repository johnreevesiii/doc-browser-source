+	{
+		calls++;
+		if (calls == failAt) { *seqOut = 0; return 0; }
+		return inner->pullLatest(dst, cap, seqOut);
+	}
+	void waitSeq(u32 s, u32 ms) override { inner->waitSeq(s, ms); }
+	void push(const u8 *f, u32 l) override { inner->push(f, l); }
+	bool linkError() override { return inner->linkError(); }
+};
+
+TEST(review7_mailbox_seq_zero_is_not_new)
+{
+	const u32 S = 0x10;
+	const int n = 2;
+	const u32 session = 0xA5A5A5A5;
+	for (u32 waitMs : { 0u, 5u })
+	{
+		std::vector<u8> region(MailboxLayout::totalBytes, 0);
+		auto io = std::make_unique<SeqZeroIo>();
+		io->inner = makeBufferMailboxIo(region.data());
+		SeqZeroIo *raw = io.get();
+		MailboxConfig cfg;
+		cfg.role = { 0, n, Edition::A };
+		cfg.sessionTag = session;
+		auto ring = makeMailboxRingBackend(cfg, std::move(io));
+		GuardedRx rx(S, n);
+		u32 fresh = 0;
+		for (u32 t = 1; t <= 10; t++)
+		{
+			auto f = asmFill(Edition::A, session, 0, n, S, t, (u16)t, (u8)t);
+			mailboxDeliver(region.data(), f.data(), (u32)f.size());
+			if (t == 6)
+				raw->failAt = raw->calls + 1;		// first pull of this take
+			if (ring->take(rx.base(), S, n, waitMs).fresh)
+				fresh++;
+		}
+		auto st = ring->stats();
+		// waitMs 0: take 6 sees seq 0 (stale), take 7 skips one delivery.
+		// waitMs > 0: take 6 pulls again after the wait and gets frame 6.
+		CHECK_EQ(fresh, waitMs == 0 ? 9u : 10u);
+		CHECK_EQ(st.dropped, waitMs == 0 ? 1u : 0u);
+		CHECK_EQ(st.badSize, 0u);
+		CHECK(rx.rxIs(10));
+	}
+}
