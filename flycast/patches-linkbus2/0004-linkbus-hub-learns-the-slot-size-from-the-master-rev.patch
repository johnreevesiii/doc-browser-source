+		std::vector<u8> tx(S * n, 0x5A);
+		p0->publish(tx.data(), S, n, 0);
+		w0->publish(tx.data(), S, n, 0);
+	}
 	bool same = true;
 	u32 freshCount = 0;
 	for (u32 g = 0; g < 40; g++)
@@ -1215,6 +1227,38 @@ TEST(review_mailbox_hostile_frames_leave_rx_untouched)
