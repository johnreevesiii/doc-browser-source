 core/network/linkbus.h         |  8 +++++--
 core/network/linkbus_web.cpp   |  6 +++--
 tests/linkbus/linkbus_test.cpp | 44 ++++++++++++++++++++++++++++++++++
 4 files changed, 65 insertions(+), 4 deletions(-)

diff --git a/core/network/linkbus.cpp b/core/network/linkbus.cpp
index 4aea7ca89..45d218d3e 100644
--- a/core/network/linkbus.cpp
+++ b/core/network/linkbus.cpp
@@ -313,6 +313,17 @@ struct InMemoryHub::Impl
 			stats.replayed++;
 			return FrameCheck::BadHeader;
 		}
+		// Review R1: the slot size is learned only from the master (node 0),
+		// never from whichever seat happens to send first. A satellite frame
+		// that arrives before the master's first frame is refused as BadSize
+		// (counted in beforeMaster) and not recorded, so a seat with a valid
+		// but different slot size cannot lock out the honest seats.
+		if (slotSize == 0 && h.nodeId != 0)
+		{
+			stats.badSize++;
+			stats.beforeMaster++;
+			return FrameCheck::BadSize;
+		}
 		haveLocal[h.nodeId] = true;
 		lastLocal[h.nodeId] = h.localFrame;
 		slotSize = h.slotSize;
diff --git a/core/network/linkbus.h b/core/network/linkbus.h
index 60c724542..fc89f717c 100644
--- a/core/network/linkbus.h
+++ b/core/network/linkbus.h
@@ -244,8 +244,8 @@ struct WireExpect
 {
 	Edition edition = Edition::Unknown;
 	u32 sessionTag = 0;
-	int slotCount = 0;		// 0 = not checked (hub learns it from the first frame)
-	u32 slotSize = 0;		// 0 = not checked
+	int slotCount = 0;		// 0 = not checked
+	u32 slotSize = 0;		// 0 = not checked (the hub learns it from the master's first frame)
 	int targetNode = -1;	// assembled frames only; -1 = not checked
 };
 
@@ -327,6 +327,9 @@ public:
 	// the bytes arrived from), never taken from the frame: a frame whose
 	// nodeId differs is refused as BadHeader. A frame whose localFrame is not
 	// newer than the last one accepted from that node is refused as a replay.
+	// The slot size is learned from the master's (node 0) first accepted
+	// frame only; satellite frames before it are refused as BadSize and
+	// counted in Stats::beforeMaster (review R1).
 	FrameCheck submit(int fromNode, const u8 *bytes, u32 size);
 	u32 hubTick() const;
 	// Tests only, before any frame: start the hub tick at `tick` (wraparound).
@@ -339,6 +342,7 @@ public:
 		u32 badSize = 0;
 		u32 badHeader = 0;		// includes a nodeId that is not the sender's
 		u32 replayed = 0;		// localFrame not newer than the last accepted
+		u32 beforeMaster = 0;	// satellite frames refused before the master's first (also in badSize)
 	};
 	Stats stats() const;
 
diff --git a/core/network/linkbus_web.cpp b/core/network/linkbus_web.cpp
index 3fe429dc2..b66582bdd 100644
--- a/core/network/linkbus_web.cpp
+++ b/core/network/linkbus_web.cpp
@@ -29,8 +29,10 @@
 
 	Both buffers must be SharedArrayBuffers at least as large as the layout
 	(MailboxLayout::totalBytes, MultiboardSabLayout::totalBytes); otherwise
-	linkbus_install_mailbox returns 3 and the SAB multiboard backend is not
