 	s1->publish(tx.data(), S, n, 5);
 	GuardedRx rx(S, n);
 	u32 firstFresh = 0;
@@ -888,6 +894,12 @@ TEST(review6_hub_tick_wraparound_matches_unwrapped)
 	auto p0 = plain.attach(0), p1 = plain.attach(1);
