 }
 
+
+// Review R1: the hub learns the slot size from the master only. A satellite
+// that sends a valid frame with a different slot size first must not lock
+// out the honest seats.
+TEST(reviewR1_hub_learns_slot_size_from_master)
+{
+	const u32 S = 0x20;
+	const int n = 3;
+	InMemoryHub hub(n, Edition::A, 0, 77);
+	auto s0 = hub.attach(0);
+	auto odd = slotFrameLf(2, n, 0x10, 0, 0x21);
+	CHECK(hub.submit(2, odd.data(), (u32)odd.size()) == FrameCheck::BadSize);
+	auto early = slotFrameLf(1, n, S, 0, 0x22);
+	CHECK(hub.submit(1, early.data(), (u32)early.size()) == FrameCheck::BadSize);
+	CHECK_EQ(hub.stats().beforeMaster, 2u);
+	CHECK_EQ(hub.stats().accepted, 0u);
+	auto m = slotFrameLf(0, n, S, 0, 0x40);
+	CHECK(hub.submit(0, m.data(), (u32)m.size()) == FrameCheck::Ok);
+	// Not recorded before: localFrame 0 is still new for node 1.
+	CHECK(hub.submit(1, early.data(), (u32)early.size()) == FrameCheck::Ok);
+	auto odd2 = slotFrameLf(2, n, 0x10, 1, 0x23);
+	CHECK(hub.submit(2, odd2.data(), (u32)odd2.size()) == FrameCheck::BadSize);
+	auto good2 = slotFrameLf(2, n, S, 1, 0x24);
+	CHECK(hub.submit(2, good2.data(), (u32)good2.size()) == FrameCheck::Ok);
+	CHECK_EQ(hub.stats().beforeMaster, 2u);
+	CHECK_EQ(hub.stats().accepted, 3u);
+	hub.tick();
+	GuardedRx rx(S, n);
+	CHECK(s0->take(rx.base(), S, n, 0).fresh);
+	CHECK(rx.canariesIntact());
+}
