+// Snapshot variant of the SAB backend (doc-wasm/linkbus2), for a
+// deterministic master pair. Each board works on a private copy of the bank
+// and of the status word and logs its writes. At each sync point (two
+// generation barriers) every board publishes its log, then applies the logs
+// of all boards in the barrier, in board id order, to its own copy, so all
+// copies are equal after every sync and nothing a board reads between sync
+// points depends on host timing. Board 0 also applies them to the shared
+// bank, which a partner copies when it is created. Writes become visible to
+// the other board at the next sync point (natively: at once). Layout: the
+// MultiboardSabLayout followed by one log region per board.
+struct MultiboardSnapshotLayout
+{
+	static constexpr u32 logEntries = kMbDataWords + 0x10000;	// distinct words + status ops
+	static constexpr u32 logHeaderBytes = 16;			// i32 entries, i32 overflow
+	static constexpr u32 logBytes = logHeaderBytes + logEntries * 8;	// entry: u32 index, u32 value
+	static constexpr u32 logBase = MultiboardSabLayout::totalBytes;
+	static constexpr u32 totalBytes = logBase + kMbMaxBoards * logBytes;
+};
+std::unique_ptr<MultiboardBackend> makeSabSnapshotMultiboardBackend(int boardId);
+
 } // namespace linkbus
