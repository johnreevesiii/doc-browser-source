+// Snapshot backend: bulk copies between the wasm heap and the cabinet buffer.
+EM_JS(void, lb_cab_put, (int byteOffset, const void *src, int bytes), {
+	new Uint8Array(Module.linkbus.cabinet, byteOffset, bytes).set(HEAPU8.subarray(src, src + bytes));
