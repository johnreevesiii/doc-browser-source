From 421edb81398abf6bf411eae797156a598b3480f1 Mon Sep 17 00:00:00 2001
From: John R Reeves III <johnreevesiii@outlook.com>
Date: Mon, 2 Nov 2026 13:49:23 -0800
Subject: [PATCH 7/9] linkbus: header-only rounds are stale, board id is
 clamped (review F6, F10)

A header-only assembled frame (the hub had no master slot size for the
round) was refused by checkAssembledFrame and counted as badSize; it is
"nothing new" and now counts as stale only. setMultiboardBoardId clamps
the id to 0..kMbMaxBoards - 1, the bits of the barrier mask.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MGX7KQ5gfrWApgW64pZbQ5
---
 core/network/linkbus.cpp | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/core/network/linkbus.cpp b/core/network/linkbus.cpp
index 518374bb1..ff8292e11 100644
--- a/core/network/linkbus.cpp
+++ b/core/network/linkbus.cpp
@@ -61,7 +61,8 @@ const MultiboardFactory& multiboardFactory() {
 static int hostBoardId;
 
 void setMultiboardBoardId(int boardId) {
-	hostBoardId = boardId;
+	// Clamp to the barrier mask (kMbMaxBoards bits).
+	hostBoardId = boardId < 0 ? 0 : boardId > kMbMaxBoards - 1 ? kMbMaxBoards - 1 : boardId;
 }
 
 int multiboardBoardId() {
@@ -706,6 +707,17 @@ public:
 		lastSeq = seq;
 
 		AssembledFrameHeader h;
+		if (len == sizeof(h))
+		{
+			// A header-only round (the hub had no master slot size yet) is
+			// "nothing new", not a malformed frame.
+			std::memcpy(&h, buf.data(), sizeof(h));
+			if (h.magic == kAssembledMagic && h.slotSize == 0)
+			{
+				st.stale++;
+				return res;
+			}
+		}
 		FrameCheck c = checkAssembledFrame(buf.data(), len, expectFor((int)slotCount, slotSize), &h);
 		if (c != FrameCheck::Ok)
 		{
