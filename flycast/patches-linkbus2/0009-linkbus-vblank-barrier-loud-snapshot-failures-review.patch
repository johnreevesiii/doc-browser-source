+// Vblank barrier (linkbus_install_vblank_barrier). Called at every guest
+// vblank: count it, then wait until the hub has delivered the round for this
+// vblank. Returns 0 ok, 1 timeout, 2 released by the host (shutdown).
+EM_JS(int, lb_vb_barrier, (int timeoutMs, int headerBytes), {
+	var lb = Module.linkbus;
+	var i32 = lb._vbI32 || (lb._vbI32 = new Int32Array(lb.mailbox, 0, headerBytes >> 2));
+	var k = Atomics.add(i32, 8, 1) + 1;
+	Atomics.notify(i32, 8);
+	var now = function () { return performance.now(); };
+	var deadline = now() + Math.max(timeoutMs, 0);
+	for (;;) {
+		var r = Atomics.load(i32, 9);
+		if (r >= k) return 0;
+		if (Atomics.load(i32, 10) !== 0) return 2;
+		var left = deadline - now();
+		if (left <= 0) return 1;
+		try {
+			Atomics.wait(i32, 9, r, Math.min(left, 200));
+		} catch (e) {
+			return 1;	// main thread: cannot block
+		}
+	}
+});
+
