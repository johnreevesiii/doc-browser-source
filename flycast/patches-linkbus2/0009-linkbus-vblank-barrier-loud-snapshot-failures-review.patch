+// Vblank barrier for the single-page cabinet (worker only). At every guest
+// vblank, before the M3 comm board's take and publish for that vblank, the
+// core stores its vblank count in the mailbox (MailboxLayout::vblankCount)
+// and waits until the hub has published the round for it
+// (MailboxLayout::hubRound >= count), up to timeoutMs (counted, latched as
+// nondeterministic). The hub publishes round k once every seat has reached
+// vblank k, after delivering each seat's newest slot frame, which is the one
+// it published at vblank k - 1. So every seat advances exactly one guest
+// vblank per hub round, the native one-tick-per-vblank model without its
+// timing. Must be installed after linkbus_install_mailbox and before the
+// game is loaded (so it runs before the comm board's vblank listener).
+EMSCRIPTEN_KEEPALIVE int linkbus_install_vblank_barrier(unsigned timeoutMs)
+{
+	if (!lb_mb_ok((int)MailboxLayout::totalBytes))
+		return 3;
+	vblankBarrierTimeoutMs = timeoutMs;
+	EventManager::listen(Event::VBlank, vblankBarrierCallback, nullptr);
+	return 0;
+}
