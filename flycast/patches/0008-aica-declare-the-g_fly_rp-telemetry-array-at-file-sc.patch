From 7c7d9871e54291b7ebce560ad52d2403c28cecdc Mon Sep 17 00:00:00 2001
From: John R Reeves III <johnreevesiii@outlook.com>
Date: Mon, 2 Nov 2026 07:18:38 -0800
Subject: [PATCH 08/22] aica: declare the g_fly_rp telemetry array at file
 scope

The two block-scope "extern double g_fly_rp[10];" declarations sat
inside namespace aica, so they named aica::g_fly_rp, which nothing
defines, and the wasm link failed with an undefined symbol. Declare
the array once at file scope under __EMSCRIPTEN__ so it binds to the
global definition in core/rend/gles/gles.cpp.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MGX7KQ5gfrWApgW64pZbQ5
---
 core/hw/aica/aica.cpp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/core/hw/aica/aica.cpp b/core/hw/aica/aica.cpp
index 01470f4c4..9cb87d222 100644
--- a/core/hw/aica/aica.cpp
+++ b/core/hw/aica/aica.cpp
@@ -9,6 +9,10 @@
 #include "hw/arm7/arm_mem.h"
 #ifdef __EMSCRIPTEN__
 #include <emscripten.h>
+// Render-phase telemetry array, defined at global scope in
+// core/rend/gles/gles.cpp. Declared here at file scope: a block-scope
+// extern inside namespace aica would name aica::g_fly_rp instead.
+extern double g_fly_rp[10];
 #endif
 
 namespace aica
@@ -92,7 +96,6 @@ static int AicaUpdate(int tag, int cycles, int jitter, void *arg)
 #ifdef __EMSCRIPTEN__
 	// Render-phase timer [5]: ARM7 interpreter slice (fires at 44.1kHz —
 	// get_now pairs add ~1-2% skew; diagnostic-grade, not verdict-grade).
-	extern double g_fly_rp[10];
 	double fly_t0 = emscripten_get_now();
 	arm::run(1);
 	g_fly_rp[5] += emscripten_get_now() - fly_t0;
@@ -108,7 +111,6 @@ static int AicaUpdate(int tag, int cycles, int jitter, void *arg)
 void timeStep()
 {
 #ifdef __EMSCRIPTEN__
-	extern double g_fly_rp[10];
 	double fly_t0 = emscripten_get_now();
 #endif
 	for (auto& timer : timers)
-- 
