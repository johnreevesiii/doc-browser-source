+// ============================================================
+// JIT self-test (test hook, called from host/tools/jit-selftest.mjs)
+// ============================================================
+// Runs against the live core after a game has loaded (memory map up). It
+// borrows the last 4 KB page of main RAM, restores it afterwards and bumps
+// its page generation so any cached block there re-verifies. Do not call it
+// in a run whose hashes matter. Returns a failure mask (0 = all pass) and
+// prints one line per check.
+//  bits 0..7: fly_block_idle_ff on decoded SH4 loops (expected value below)
+//  bit 8: an ifb store (or.b #imm,@(R0,GBR)) through wasm_exec_ifb did not
+//         bump g_fly_page_gen for the written page
+//  bit 9: the ifb store did not reach RAM (test setup broken)
+//  bit 10: WriteMem* pointers were not restored after the ifb op
+//  bit 11: control: the same store through OpPtr without the guard DID bump
+//          (would make bit 8 meaningless)
+//  bit 12: a test block failed to decode
+extern "C" u32 EMSCRIPTEN_KEEPALIVE fly_jit_selftest()
+{
+	Sh4Context& ctx = Sh4cntx;
+	const u32 off = (RAM_SIZE - 0x1000) & RAM_MASK;
+	const u32 base = 0x8C000000u | off;
+	static u8 saved[0x1000];
+	memcpy(saved, &mem_b[off], sizeof(saved));
+	u32 fails = 0;
+
+	struct Case { const char* name; u16 code[6]; u32 n; bool expect; };
+	static const Case cases[] = {
+		// L: mov.l @r4,r0; tst #1,r0; bt L        pure poll
+		{ "poll", { 0x6042, 0xC801, 0x89FC, 0x0009 }, 4, true },
+		// L: mov.l @r4,r0; tst #1,r0; bf/s L; dt r5   poll with timeout
+		{ "poll-timeout", { 0x6042, 0xC801, 0x8FFC, 0x4510, 0x0009 }, 5, false },
+		// L: add #1,r1; mov.l @r2,r0; tst #1,r0; bt L   calibration
+		{ "calibration", { 0x7101, 0x6022, 0xC801, 0x89FB, 0x0009 }, 5, false },
+		// L: add #1,r0; mov.l r0,@r1; bra L; nop   static loop with a store
+		{ "static-store", { 0x7001, 0x2102, 0xAFFC, 0x0009 }, 4, false },
+		// L: bra L; nop   bare wait
+		{ "static-wait", { 0xAFFE, 0x0009 }, 2, true },
+		// L: mov.l @r4,r0; pref @r1; tst #1,r0; bt L   poll with pref
+		{ "poll-pref", { 0x6042, 0x0183, 0xC801, 0x89FB, 0x0009 }, 5, false },
+		// L: mov.l @r4,r0; mov.l r0,@r6; tst #1,r0; bt L   poll with store
+		{ "poll-store", { 0x6042, 0x2602, 0xC801, 0x89FB, 0x0009 }, 5, false },
+		// L: add #1,r1; bra L; nop   static counter, no memory
+		{ "static-count", { 0x7101, 0xAFFD, 0x0009 }, 3, false },
+	};
+	for (u32 ci = 0; ci < sizeof(cases) / sizeof(cases[0]); ci++) {
+		const Case& c = cases[ci];
+		for (u32 k = 0; k < c.n; k++)
+			*(u16*)&mem_b[off + k * 2] = c.code[k];
+		RuntimeBlockInfo* blk = new RuntimeBlockInfo();
+		bool ok = blk->Setup(base, ctx.fpscr);
+		bool got = ok && fly_block_idle_ff(blk);
+		if (!ok)
+			fails |= 1u << 12;
+		if (!ok || got != c.expect)
+			fails |= 1u << ci;
+		printf("[selftest] idle_ff %-13s ops=%u type=%u expect=%d got=%d %s\n",
+			c.name, ok ? (u32)blk->oplist.size() : 0u, ok ? blk->BlockType : 0u,
+			c.expect, got, (ok && got == c.expect) ? "PASS" : "FAIL");
+		delete blk;
+	}
+
+	// ifb store: or.b #0x5A,@(R0,GBR) (0xCF5A) decodes to shop_ifb
+	{
+		const u32 page = off >> 12;
+		const u32 save_r0 = ctx.r[0], save_gbr = ctx.gbr;
+		WriteMem8Func w8 = WriteMem8; WriteMem16Func w16 = WriteMem16;
+		WriteMem32Func w32 = WriteMem32; WriteMem64Func w64 = WriteMem64;
+		ctx.r[0] = 0x10;
+		ctx.gbr = base;
+		mem_b[off + 0x10] = 0x00;
+		u32 g0 = g_fly_page_gen[page];
+		wasm_exec_ifb(0xCF5A, base);
+		u32 g1 = g_fly_page_gen[page];
+		bool bumped = g1 != g0;
+		bool stored = mem_b[off + 0x10] == 0x5A;
+		bool restored = WriteMem8 == w8 && WriteMem16 == w16 && WriteMem32 == w32 && WriteMem64 == w64;
+		if (!bumped) fails |= 1u << 8;
+		if (!stored) fails |= 1u << 9;
+		if (!restored) fails |= 1u << 10;
+		// Control: the bare interpreter handler (no guard) must not bump.
+		mem_b[off + 0x10] = 0x00;
+		u32 g2 = g_fly_page_gen[page];
+		OpPtr[0xCF5A](&ctx, 0xCF5A);
+		bool ctrl_bumped = g_fly_page_gen[page] != g2;
+		if (ctrl_bumped) fails |= 1u << 11;
+		printf("[selftest] ifb or.b gen %u->%u stored=%d restored=%d control_bump=%d %s\n",
+			g0, g1, stored, restored, ctrl_bumped,
+			(bumped && stored && restored && !ctrl_bumped) ? "PASS" : "FAIL");
+		ctx.r[0] = save_r0;
+		ctx.gbr = save_gbr;
+	}
+
+	memcpy(&mem_b[off], saved, sizeof(saved));
+	fly_ram_written(base, sizeof(saved));
+	printf("[selftest] done fails=0x%x\n", fails);
+	return fails;
+}
