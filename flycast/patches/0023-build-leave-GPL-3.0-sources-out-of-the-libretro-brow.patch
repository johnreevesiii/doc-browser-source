+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+// Savestate hooks for builds without RetroAchievements (the libretro build).
+// A savestate from version V50 on carries a size-prefixed achievements block:
+// write an empty one, and skip whatever block a loaded state carries.
+#include "achievements.h"
+#include "serialize.h"
+
+#ifdef USE_RACHIEVEMENTS
+#error "achievements_stub.cpp is for builds without USE_RACHIEVEMENTS"
+#endif
+
+namespace achievements
+{
+
+void serialize(Serializer& ser)
+{
+	u32 size = 0;
+	ser << size;
+}
+
+void deserialize(Deserializer& deser)
+{
+	if (deser.version() >= Deserializer::V50)
+	{
+		u32 size;
+		deser >> size;
+		deser.skip(size);
+	}
+}
+
+}	// namespace achievements
diff --git a/core/imgread/CMakeLists.txt b/core/imgread/CMakeLists.txt
index ca2ecf2e9..5c7223b9d 100644
--- a/core/imgread/CMakeLists.txt
+++ b/core/imgread/CMakeLists.txt
@@ -6,7 +6,11 @@ target_sources(${PROJECT_NAME} PRIVATE
         common.h
         cue.cpp
         gdi.cpp
-        ImgReader.cpp
-        iso9660.h
-        isofs.cpp
-        isofs.h)
+        ImgReader.cpp)
+
+if(USE_ISOFS)
+    target_sources(${PROJECT_NAME} PRIVATE
+            iso9660.h
+            isofs.cpp
+            isofs.h)
+endif()
diff --git a/core/reios/reios.cpp b/core/reios/reios.cpp
index f82353178..16234fab2 100644
--- a/core/reios/reios.cpp
+++ b/core/reios/reios.cpp
@@ -23,7 +23,9 @@
 #include "hw/aica/aica_if.h"
 #include "hw/pvr/pvr_regs.h"
 #include "imgread/common.h"
+#ifndef NO_ISOFS
 #include "imgread/isofs.h"
+#endif
 #include "hw/sh4/sh4_mmr.h"
 #include "oslib/resources.h"
 #include "oslib/oslib.h"
@@ -73,6 +75,13 @@ static bool reios_locate_bootfile(const char* bootfile)
 	// Load IP.BIN bootstrap
 	libGDR_ReadSector(GetMemPtr(0x8c008000, 0), base_fad, 16, 2048);
 
+#ifdef NO_ISOFS
+	// Built without the ISO 9660 reader (USE_ISOFS=OFF): a Dreamcast disc
+	// cannot be booted through the HLE BIOS. reios_boot reports the failure.
+	// NAOMI never comes here: reios_boot loads a NAOMI game from the cartridge.
+	ERROR_LOG(REIOS, "Boot file '%s' not loaded: built without the ISO 9660 reader", bootfile);
+	return false;
+#else
 	IsoFs isofs(disc);
 	std::unique_ptr<IsoFs::Directory> root(isofs.getRoot());
 	if (root == nullptr)
@@ -134,6 +143,7 @@ static bool reios_locate_bootfile(const char* bootfile)
 	memcpy(GetMemPtr(0x8c000068, sizeof(data)), data, sizeof(data));
 
 	return true;
+#endif // NO_ISOFS
 }
 
 ip_meta_t ip_meta;
