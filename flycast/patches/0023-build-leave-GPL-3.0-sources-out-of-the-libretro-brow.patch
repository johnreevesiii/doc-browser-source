From 4cb999d50434f7ad00bdbee2ef0d62b68804bdbe Mon Sep 17 00:00:00 2001
From: John R Reeves III <johnreevesiii@outlook.com>
Date: Thu, 5 Nov 2026 12:00:00 -0800
Subject: [PATCH] build: leave GPL-3.0 sources out of the libretro browser
 build

Two files in the browser core carry GPL version 3 terms. Neither is
needed to run NAOMI games.

1. core/imgread/isofs.cpp includes libcdio's iso9660.h
   (GPL-3.0-or-later). New option USE_ISOFS: OFF by default when LIBRETRO
   and EMSCRIPTEN (the browser core), ON otherwise. With it OFF,
   iso9660.h, isofs.cpp and isofs.h are not part of the build, NO_ISOFS
   is defined, and reios_locate_bootfile (Dreamcast HLE BIOS disc boot)
   logs an error and returns false, so reios_boot reports "Failed to
   locate bootfile". It is reached only when
   settings.platform.isConsole(); reios_boot loads a NAOMI game from the
   cartridge and never uses the ISO reader. The only other user, the box
   art scraper, is built only without LIBRETRO, so USE_ISOFS=OFF is
   refused there.

2. core/achievements/achievements.cpp is derived from DuckStation and
   marked "GPL-3.0 OR CC-BY-NC-ND-4.0". The libretro build never defines
   USE_RACHIEVEMENTS, so it compiled only the file's savestate stub. It
   now compiles core/achievements/achievements_stub.cpp (new,
   GPL-2.0-or-later) instead, which writes and skips the same
   size-prefixed block, so savestates are unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MGX7KQ5gfrWApgW64pZbQ5
---
 CMakeLists.txt                          | 17 +++++++++
 core/achievements/CMakeLists.txt        | 16 +++++++--
 core/achievements/achievements_stub.cpp | 48 +++++++++++++++++++++++++
 core/imgread/CMakeLists.txt             | 12 ++++---
 core/reios/reios.cpp                    | 10 ++++++
 5 files changed, 96 insertions(+), 7 deletions(-)
 create mode 100644 core/achievements/achievements_stub.cpp

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8db85cd80..ae42113c8 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -942,6 +942,23 @@ if(NOT LIBRETRO)
 			core/deps/implot/implot_items.cpp)
 	endif()
 endif()
+# The ISO 9660 reader (core/imgread/isofs.cpp) includes libcdio's iso9660.h,
+# which is GPL-3.0-or-later. Only the Dreamcast HLE BIOS disc boot
+# (reios_locate_bootfile) and the standalone UI's box art scraper use it.
+# The browser (libretro, Emscripten) build runs NAOMI games from ROM files
+# and leaves it out by default, so the unchanged build-win.ps1 drops it.
+if(LIBRETRO AND EMSCRIPTEN)
+	set(USE_ISOFS_DEFAULT OFF)
+else()
+	set(USE_ISOFS_DEFAULT ON)
+endif()
+option(USE_ISOFS "Build the ISO 9660 reader for Dreamcast disc boot (uses libcdio's iso9660.h, GPL-3.0-or-later)" ${USE_ISOFS_DEFAULT})
+if(NOT USE_ISOFS)
+	if(NOT LIBRETRO)
+		message(FATAL_ERROR "USE_ISOFS=OFF is only supported in the libretro build (the box art scraper needs IsoFs)")
+	endif()
+	target_compile_definitions(${PROJECT_NAME} PRIVATE NO_ISOFS)
+endif()
 if(USE_XBRZ)
 	target_sources(${PROJECT_NAME} PRIVATE core/deps/xbrz/xbrz.cpp)
 else()
diff --git a/core/achievements/CMakeLists.txt b/core/achievements/CMakeLists.txt
index 57d8814e7..6e1f62e57 100644
--- a/core/achievements/CMakeLists.txt
+++ b/core/achievements/CMakeLists.txt
@@ -1,3 +1,13 @@
-target_sources(${PROJECT_NAME} PRIVATE
-        achievements.cpp
-        achievements.h)
+# achievements.cpp is derived from DuckStation and marked
+# "GPL-3.0 OR CC-BY-NC-ND-4.0". The libretro build has no RetroAchievements
+# (USE_RACHIEVEMENTS is defined only without LIBRETRO) and only needs the
+# savestate stub, so it compiles achievements_stub.cpp instead.
+if(LIBRETRO)
+    target_sources(${PROJECT_NAME} PRIVATE
+            achievements_stub.cpp
+            achievements.h)
+else()
+    target_sources(${PROJECT_NAME} PRIVATE
+            achievements.cpp
+            achievements.h)
+endif()
diff --git a/core/achievements/achievements_stub.cpp b/core/achievements/achievements_stub.cpp
new file mode 100644
index 000000000..297321635
--- /dev/null
+++ b/core/achievements/achievements_stub.cpp
@@ -0,0 +1,48 @@
